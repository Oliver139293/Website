local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Library = {}
Library.__index = Library

local Theme = {
    Main = Color3.fromRGB(49,49,49),
    Content = Color3.fromRGB(33,33,33),
    Border = Color3.fromRGB(150,190,255),
    DarkBorder = Color3.fromRGB(75,75,75),
    Text = Color3.fromRGB(214,214,214),
    SubText = Color3.fromRGB(207,207,207),
    Fill = Color3.fromRGB(150,190,255),
}

local function stroke(parent, color, thickness, mode)
    local s = Instance.new("UIStroke")
    s.Parent = parent
    s.ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border
    s.Color = color
    s.Thickness = thickness
    s.Transparency = 0
    return s
end

local function label(parent, text, pos, size)
    local l = Instance.new("TextLabel")
    l.Parent = parent
    l.BackgroundTransparency = 1
    l.BorderSizePixel = 0
    l.Position = pos
    l.Size = size
    l.ZIndex = 5
    l.Font = Enum.Font.SourceSansBold
    l.Text = text
    l.TextColor3 = Theme.SubText
    l.TextSize = 12
    l.TextXAlignment = Enum.TextXAlignment.Left
    stroke(l, Color3.fromRGB(0,0,0), 1, Enum.ApplyStrokeMode.Contextual)
    return l
end

local function makeToggle(parent, name, text, y)
    local row = Instance.new("Frame")
    row.Name = name .. "Row"
    row.Parent = parent
    row.BackgroundTransparency = 1
    row.Position = UDim2.new(0.72,0,y,0)
    row.Size = UDim2.new(0,150,0,20)
    row.ZIndex = 5

    local button = Instance.new("TextButton")
    button.Name = name .. "Toggle"
    button.Parent = row
    button.BackgroundColor3 = Theme.Content
    button.BorderSizePixel = 0
    button.Position = UDim2.new(0,0,1,0)
    button.Size = UDim2.new(0,14,0,14)
    button.ZIndex = 5
    button.Text = ""
    stroke(button, Theme.Border, 0.6)

    local fill = Instance.new("Frame")
    fill.Name = name .. "ToggleFill"
    fill.Parent = button
    fill.BackgroundColor3 = Theme.Fill
    fill.BorderSizePixel = 0
    fill.Position = UDim2.new(0,2,0,2)
    fill.Size = UDim2.new(0,0,0,0)
    fill.ZIndex = 6

    local l = label(row,text,UDim2.new(0,20,0,20),UDim2.new(0,130,0,14))

    local state = false
    local object = {}
    object.Instance = button
    object.Label = l
    object.Value = false

    local function set(v)
        state = not not v
        object.Value = state
        fill.Size = state and UDim2.new(0,10,0,10) or UDim2.new(0,0,0,0)
        if object._callback then object._callback(state) end
    end

    button.MouseButton1Click:Connect(function() set(not state) end)
    function object:Set(v) set(v) end
    function object:Get() return state end
    function object:OnChanged(fn) object._callback = fn return object end
    return object
end

local function makeTextbox(parent, name, placeholder, pos, size)
    local box = Instance.new("TextBox")
    box.Name = name
    box.Parent = parent
    box.BackgroundColor3 = Theme.Content
    box.BorderSizePixel = 0
    box.Position = pos
    box.Size = size or UDim2.new(0,93,0,16)
    box.ZIndex = 5
    box.Font = Enum.Font.SourceSans
    box.PlaceholderText = placeholder or "Enter value.."
    box.Text = ""
    box.TextColor3 = Color3.fromRGB(225,225,225)
    box.TextSize = 10
    stroke(box, Theme.Border, 0.6)

    local object = {Instance=box}
    function object:Get() return box.Text end
    function object:Set(v) box.Text = tostring(v) end
    function object:OnChanged(fn) box:GetPropertyChangedSignal("Text"):Connect(function() fn(box.Text) end) return object end
    function object:OnFocusLost(fn) box.FocusLost:Connect(function(...) fn(box.Text, ...) end) return object end
    return object
end

function Library:CreateWindow(options)
    options = options or {}
    local player = Players.LocalPlayer
    local gui = Instance.new("ScreenGui")
    gui.Name = options.Name or "KetamineUI"
    gui.Parent = player:WaitForChild("PlayerGui")
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.ResetOnSpawn = false

    local main = Instance.new("Frame")
    main.Name = "MainFrame"
    main.Parent = gui
    main.Active = true
    main.BackgroundColor3 = Theme.Main
    main.BorderSizePixel = 0
    main.Position = options.Position or UDim2.new(0.264584661,73,0.1289507,4)
    main.Size = UDim2.new(0,442,0,383)
    main.ZIndex = 100
    stroke(main, Theme.Border, 1.8)
    stroke(main, Color3.fromRGB(0,0,0), 1, Enum.ApplyStrokeMode.Contextual)

    local dragArea = Instance.new("Frame")
    dragArea.Name = "DragArea"
    dragArea.Parent = main
    dragArea.BackgroundTransparency = 1
    dragArea.BorderSizePixel = 0
    dragArea.Size = UDim2.new(1,0,0,38)
    dragArea.Position = UDim2.new(0,0,0,0)
    dragArea.ZIndex = 200
    dragArea.Active = true

    local title = Instance.new("TextLabel")
    title.Parent = main
    title.BackgroundTransparency = 1
    title.BorderSizePixel = 0
    title.Position = UDim2.new(0.03,0,0,0)
    title.Size = UDim2.new(0,180,0,38)
    title.Font = Enum.Font.SourceSansBold
    title.Text = options.Title or "Ketamine"
    title.TextColor3 = Theme.Text
    title.TextSize = 13
    title.ZIndex = 201
    stroke(title, Color3.fromRGB(0,0,0), 1, Enum.ApplyStrokeMode.Contextual)

    local content = Instance.new("Frame")
    content.Parent = main
    content.BackgroundColor3 = Theme.Content
    content.BorderSizePixel = 0
    content.Position = UDim2.new(0.0175741203,0,0.0992167071,0)
    content.Size = UDim2.new(0,426,0,335)
    stroke(content, Theme.DarkBorder, 1)

    local indicator = Instance.new("Frame")
    indicator.Name = "TabIndicator"
    indicator.Parent = content
    indicator.BackgroundColor3 = Theme.Main
    indicator.BorderSizePixel = 0
    indicator.Position = UDim2.new(0.021,0,0.058,0)
    indicator.Size = UDim2.new(0,42,0,3)
    indicator.ZIndex = 6

    local tabs = {}
    local window = {GUI=gui, Frame=main, Content=content, Tabs=tabs}

    -- Explicit drag implementation; this is UI behaviour only.
    local dragging, dragStart, startPos
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
        end
    end)

    function window:AddTab(name)
        local index = #tabs
        local button = Instance.new("TextButton")
        button.Name = name .. "TabButton"
        button.Parent = content
        button.BackgroundColor3 = Color3.fromRGB(48,48,48)
        button.BorderSizePixel = 0
        button.Position = UDim2.new(0.0211267602 + index*0.14,0,0.0249400157,0)
        button.Size = UDim2.new(0,42,0,13)
        button.ZIndex = 5
        button.Font = Enum.Font.SourceSansBold
        button.Text = name
        button.TextColor3 = Color3.fromRGB(220,220,220)
        button.TextSize = 10
        stroke(button, Theme.DarkBorder, 1)

        local panel = Instance.new("Frame")
        panel.Name = name .. "ContentPanel"
        panel.Parent = content
        panel.BackgroundColor3 = Theme.Main
        panel.BorderSizePixel = 0
        panel.Position = UDim2.new(0.0211267602,0,0.0635157749,0)
        panel.Size = UDim2.new(0,407,0,303)
        panel.ZIndex = 4
        panel.Visible = index == 0
        stroke(panel, Color3.fromRGB(0,0,0), 1)

        local tab = {Button=button, Panel=panel}
        table.insert(tabs,tab)

        button.MouseButton1Click:Connect(function()
            for _, t in ipairs(tabs) do t.Panel.Visible = false end
            panel.Visible = true
            indicator.Position = UDim2.new(button.Position.X.Scale,button.Position.X.Offset,0.058,0)
        end)

        function tab:AddToggle(text, y)
            return makeToggle(panel, text:gsub("%W",""), text, y or 0.05)
        end
        function tab:AddTextbox(text, placeholder, pos, size)
            return makeTextbox(panel, text:gsub("%W",""), placeholder, pos, size)
        end
        function tab:AddLabel(text, pos, size)
            return label(panel,text,pos or UDim2.new(0,20,0,20),size or UDim2.new(0,150,0,14))
        end
        function tab:AddSection(text, pos)
            return tab:AddLabel(text,pos,UDim2.new(0,180,0,16))
        end
        function tab:AddButton(text, pos)
            local b=Instance.new("TextButton")
            b.Parent=panel; b.BackgroundColor3=Theme.Content; b.BorderSizePixel=0
            b.Position=pos or UDim2.new(0,20,0,20); b.Size=UDim2.new(0,100,0,22)
            b.Font=Enum.Font.SourceSansBold; b.Text=text; b.TextColor3=Theme.Text; b.TextSize=11; b.ZIndex=6
            stroke(b,Theme.Border,0.6)
            local obj={Instance=b}
            function obj:OnClick(fn) b.MouseButton1Click:Connect(fn); return obj end
            return obj
        end
        function tab:AddSlider(text, min, max, default, pos)
            min=min or 0; max=max or 100; default=default or min
            local holder=Instance.new("Frame"); holder.Parent=panel; holder.BackgroundTransparency=1
            holder.Position=pos or UDim2.new(0.05,0,0.78,0); holder.Size=UDim2.new(0,180,0,38); holder.ZIndex=6
            local l=label(holder,text,UDim2.new(0,0,0,0),UDim2.new(0,100,0,14))
            local value=Instance.new("TextLabel"); value.Parent=holder; value.BackgroundTransparency=1; value.Position=UDim2.new(0,115,0,0); value.Size=UDim2.new(0,50,0,14); value.Font=Enum.Font.SourceSans; value.TextSize=10; value.TextColor3=Theme.Text; value.Text=tostring(default); value.ZIndex=6
            local bar=Instance.new("Frame"); bar.Parent=holder; bar.BackgroundColor3=Color3.fromRGB(65,65,65); bar.BorderSizePixel=0; bar.Position=UDim2.new(0,0,0,22); bar.Size=UDim2.new(0,165,0,5); bar.ZIndex=6
            local knob=Instance.new("Frame"); knob.Parent=bar; knob.BackgroundColor3=Theme.Fill; knob.BorderSizePixel=0; knob.Size=UDim2.new(0,8,0,8); knob.AnchorPoint=Vector2.new(0.5,0.5); knob.Position=UDim2.new((default-min)/(max-min),0,0.5,0); knob.ZIndex=7; Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)
            local obj={Value=default,Bar=bar,Knob=knob,Label=value}
            local draggingSlider=false
            local function setFromX(x)
                local pct=math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
                local v=math.floor(min+(max-min)*pct+0.5); obj.Value=v; value.Text=tostring(v); knob.Position=UDim2.new(pct,0,0.5,0); if obj._callback then obj._callback(v) end
            end
            bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then draggingSlider=true; setFromX(i.Position.X) end end)
            UserInputService.InputChanged:Connect(function(i) if draggingSlider and i.UserInputType==Enum.UserInputType.MouseMovement then setFromX(i.Position.X) end end)
            UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then draggingSlider=false end end)
            function obj:Set(v) obj.Value=math.clamp(v,min,max); local p=(obj.Value-min)/(max-min); value.Text=tostring(obj.Value); knob.Position=UDim2.new(p,0,0.5,0); return obj end
            function obj:OnChanged(fn) obj._callback=fn; return obj end
            return obj
        end
        return tab
    end

    function window:SetVisible(v) gui.Enabled=v end
    function window:Destroy() gui:Destroy() end
    return window
end

Library.Theme = Theme
return Library
