            --// =================================================
            --// CREATE SLIDER
            --// =================================================

            function Section:CreateSlider(options)

                options = options or {}

                local slider = {}

                local min =
                    options.Min or 0

                local max =
                    options.Max or 100

                local value =
                    math.clamp(
                        options.Default
                        or min,
                        min,
                        max
                    )

                local Row = Create("Frame", {

                    Parent = Controls,

                    BackgroundTransparency = 1,

                    Size = UDim2.new(
                        1,
                        0,
                        0,
                        44
                    ),

                    ZIndex = 107,
                })

                local Label = CreateLabel(
                    Row,
                    options.Name or "Slider"
                )

                Label.Size =
                    UDim2.new(
                        1,
                        -50,
                        0,
                        18
                    )

                local ValueLabel = Create(
                    "TextLabel",
                    {

                        Parent = Row,

                        BackgroundTransparency = 1,

                        Position = UDim2.new(
                            1,
                            -45,
                            0,
                            0
                        ),

                        Size = UDim2.fromOffset(
                            45,
                            18
                        ),

                        Font =
                            Enum.Font.SourceSans,

                        Text =
                            tostring(value),

                        TextColor3 =
                            Library.Theme.TextBright,

                        TextSize = 10,

                        TextXAlignment =
                            Enum.TextXAlignment.Right,

                        ZIndex = 108,
                    }
                )

                local SliderBar = Create(
                    "Frame",
                    {

                        Parent = Row,

                        BackgroundColor3 =
                            Color3.fromRGB(
                                75,
                                75,
                                75
                            ),

                        BorderSizePixel = 0,

                        Position =
                            UDim2.fromOffset(
                                0,
                                28
                            ),

                        Size =
                            UDim2.new(
                                1,
                                0,
                                0,
                                3
                            ),

                        ZIndex = 108,
                    }
                )

                AddCorner(SliderBar, 2)

                local SliderFill = Create(
                    "Frame",
                    {

                        Parent = SliderBar,

                        BackgroundColor3 =
                            Library.Theme.Accent,

                        BorderSizePixel = 0,

                        Size =
                            UDim2.new(
                                0,
                                0,
                                1,
                                0
                            ),

                        ZIndex = 109,
                    }
                )

                AddCorner(SliderFill, 2)

                local Knob = Create(
                    "Frame",
                    {

                        Parent = SliderBar,

                        BackgroundColor3 =
                            Library.Theme.Accent,

                        BorderSizePixel = 0,

                        AnchorPoint =
                            Vector2.new(
                                0.5,
                                0.5
                            ),

                        Position =
                            UDim2.new(
                                0,
                                0,
                                0.5,
                                0
                            ),

                        Size =
                            UDim2.fromOffset(
                                12,
                                12
                            ),

                        ZIndex = 110,
                    }
                )

                AddCorner(Knob, 6)

                AddStroke(
                    Knob,
                    Color3.fromRGB(
                        255,
                        255,
                        255
                    ),
                    1
                )

                local draggingSlider = false

                local function UpdateSlider(
                    mouseX,
                    callback
                )

                    local absolutePosition =
                        SliderBar.AbsolutePosition

                    local absoluteSize =
                        SliderBar.AbsoluteSize

                    local percentage =
                        math.clamp(
                            (
                                mouseX
                                - absolutePosition.X
                            )
                            / absoluteSize.X,

                            0,
                            1
                        )

                    value =
                        min
                        + (
                            max - min
                        ) * percentage

                    if options.Rounding then

                        local rounding =
                            options.Rounding

                        value =
                            math.floor(
                                value
                                * rounding
                                + 0.5
                            )
                            / rounding

                    else

                        value =
                            math.floor(
                                value + 0.5
                            )

                    end

                    local normalized =
                        (value - min)
                        / (max - min)

                    SliderFill.Size =
                        UDim2.new(
                            normalized,
                            0,
                            1,
                            0
                        )

                    Knob.Position =
                        UDim2.new(
                            normalized,
                            0,
                            0.5,
                            0
                        )

                    ValueLabel.Text =
                        tostring(value)

                    if callback
                        and options.Callback then

                        options.Callback(value)

                    end

                end

                local function BeginSlider(input)

                    if input.UserInputType
                        ~= Enum.UserInputType.MouseButton1
                        and input.UserInputType
                        ~= Enum.UserInputType.Touch then

                        return

                    end

                    draggingSlider = true

                    UpdateSlider(
                        input.Position.X,
                        true
                    )

                end

                SliderBar.InputBegan:Connect(
                    BeginSlider
                )

                Knob.InputBegan:Connect(
                    BeginSlider
                )

                UserInputService.InputChanged:Connect(
                    function(input)

                        if not draggingSlider then
                            return
                        end

                        if input.UserInputType
                            == Enum.UserInputType.MouseMovement
                            or input.UserInputType
                            == Enum.UserInputType.Touch then

                            UpdateSlider(
                                input.Position.X,
                                true
                            )

                        end

                    end
                )

                UserInputService.InputEnded:Connect(
                    function(input)

                        if input.UserInputType
                            == Enum.UserInputType.MouseButton1
                            or input.UserInputType
                            == Enum.UserInputType.Touch then

                            draggingSlider = false

                        end

                    end
                )

                function slider:SetValue(newValue)

                    value =
                        math.clamp(
                            newValue,
                            min,
                            max
                        )

                    local normalized =
                        (value - min)
                        / (max - min)

                    SliderFill.Size =
                        UDim2.new(
                            normalized,
                            0,
                            1,
                            0
                        )

                    Knob.Position =
                        UDim2.new(
                            normalized,
                            0,
                            0.5,
                            0
                        )

                    ValueLabel.Text =
                        tostring(value)

                    if options.Callback then
                        options.Callback(value)
                    end

                end

                function slider:GetValue()

                    return value

                end

                slider:SetValue(value)

                return slider

            end

            --// =================================================
            --// CREATE LABEL
            --// =================================================

            function Section:CreateLabel(text)

                local label = Create(
                    "TextLabel",
                    {

                        Parent = Controls,

                        BackgroundTransparency = 1,

                        Size = UDim2.new(
                            1,
                            0,
                            0,
                            22
                        ),

                        Font =
                            Enum.Font.SourceSansBold,

                        Text = text or "",

                        TextColor3 =
                            Library.Theme.Text,

                        TextSize = 12,

                        TextXAlignment =
                            Enum.TextXAlignment.Left,

                        ZIndex = 107,
                    }
                )

                AddStroke(
                    label,
                    Library.Theme.Shadow,
                    1
                )

                return label

            end

            table.insert(
                Tab.Sections,
                Section
            )

            return Section

        end

        --// =================================================
        --// TAB SWITCHING
        --// =================================================

        local function ActivateTab()

            for _, otherTab in ipairs(
                Window.Tabs
            ) do

                otherTab.Page.Visible = false

                Tween(
                    otherTab.Button,
                    {
                        BackgroundColor3 =
                            Color3.fromRGB(
                                48,
                                48,
                                48
                            )
                    }
                )

            end

            TabPage.Visible = true

            Tween(
                TabButton,
                {
                    BackgroundColor3 =
                        Color3.fromRGB(
                            60,
                            60,
                            60
                        )
                }
            )

            Window.ActiveTab = Tab

        end

        TabButton.MouseButton1Click:Connect(
            ActivateTab
        )

        Tab.Button = TabButton
        Tab.Page = TabPage

        table.insert(
            Window.Tabs,
            Tab
        )

        --// First tab automatically opens.

        if #Window.Tabs == 1 then
            ActivateTab()
        end

        return Tab

    end

    --// =====================================================
    --// WINDOW METHODS
    --// =====================================================

    function Window:SetTitle(title)

        Window.Title = title

        TitleLabel.Text = title

    end

    function Window:Destroy()

        ScreenGui:Destroy()

    end

    return Window

end

--// =========================================================
--// RETURN LIBRARY
--// =========================================================

return Library
