                end

                return Textbox
            end

            --================================================
            -- KEYBIND
            --================================================

            function Section:CreateKeybind(options)

                options = options or {}

                local Keybind = {}

                local currentKey = options.Default or Enum.KeyCode.Unknown
                local listening = false

                local holder = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 50),
                    BackgroundColor3 = Z3US.Theme.Card,
                    BorderSizePixel = 0,
                    Parent = SectionContainer
                })

                Corner(holder, 7)

                local Name = New("TextLabel", {
                    Position = UDim2.fromOffset(12, 0),
                    Size = UDim2.new(0.5, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = options.Name or "Keybind",
                    TextColor3 = Z3US.Theme.Text,
                    TextSize = 12,
                    Font = Z3US.Font,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = holder
                })

                local KeyButton = New("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.fromOffset(100, 32),
                    BackgroundColor3 = Z3US.Theme.Background2,
                    BorderSizePixel = 0,
                    Text = currentKey.Name,
                    TextColor3 = Z3US.Theme.SubText,
                    TextSize = 11,
                    Font = Z3US.Font,
                    AutoButtonColor = false,
                    Parent = holder
                })

                Corner(KeyButton, 6)
                Stroke(KeyButton, Z3US.Theme.Stroke, 1, 0.4)

                KeyButton.MouseButton1Click:Connect(function()

                    listening = true
                    KeyButton.Text = "Press key..."

                    Tween(KeyButton, Z3US.TweenFast, {
                        BackgroundColor3 = Z3US.Theme.AccentDark
                    })
                end)

                UserInputService.InputBegan:Connect(function(input, processed)

                    if listening then

                        if input.UserInputType == Enum.UserInputType.Keyboard then

                            currentKey = input.KeyCode
                            listening = false

                            KeyButton.Text = currentKey.Name

                            Tween(KeyButton, Z3US.TweenFast, {
                                BackgroundColor3 = Z3US.Theme.Background2
                            })

                            if options.Callback then
                                task.spawn(options.Callback, currentKey)
                            end
                        end

                    elseif not processed then

                        if input.KeyCode == currentKey then

                            if options.Changed then
                                task.spawn(options.Changed)
                            end
                        end
                    end
                end)

                function Keybind:Set(key)
                    currentKey = key
                    KeyButton.Text = key.Name
                end

                function Keybind:Get()
                    return currentKey
                end

                return Keybind
            end

            return Section
        end

        --====================================================
        -- ADD SECTION ALIAS
        --====================================================

        Tab.AddSection = Tab.CreateSection

        --====================================================
        -- ACTIVATE FIRST TAB
        --====================================================

        if #Tabs == 1 then
            task.defer(Activate)
        end

        return Tab
    end

    --========================================================
    -- MINIMIZE
    --========================================================

    local minimized = false
    local originalSize = Main.Size

    Minimize.MouseButton1Click:Connect(function()

        minimized = not minimized

        if minimized then

            Tween(Main, Z3US.TweenSlow, {
                Size = UDim2.fromOffset(originalSize.X.Offset, 45)
            })

            Body.Visible = false

        else

            Body.Visible = true

            Tween(Main, Z3US.TweenSlow, {
                Size = originalSize
            })
        end
    end)

    --========================================================
    -- MAXIMIZE
    --========================================================

    local maximized = false
    local normalSize = Main.Size
    local normalPosition = Main.Position

    Maximize.MouseButton1Click:Connect(function()

        maximized = not maximized

        if maximized then

            normalSize = Main.Size
            normalPosition = Main.Position

            Tween(Main, Z3US.TweenSlow, {
                Size = UDim2.new(1, -40, 1, -40),
                Position = UDim2.fromScale(0.5, 0.5)
            })

        else

            Tween(Main, Z3US.TweenSlow, {
                Size = normalSize,
                Position = normalPosition
            })
        end
    end)

    --========================================================
    -- CLOSE
    --========================================================

    Close.MouseButton1Click:Connect(function()

        Tween(Main, Z3US.TweenSlow, {
            Size = UDim2.fromOffset(
                Main.AbsoluteSize.X,
                0
            ),
            BackgroundTransparency = 1
        })

        task.delay(0.35, function()

            if ScreenGui then
                ScreenGui:Destroy()
            end
        end)
    end)

    --========================================================
    -- TOGGLE KEY
    --========================================================

    local visible = true

    UserInputService.InputBegan:Connect(function(input, processed)

        if processed then
            return
        end

        if input.KeyCode == Window.ToggleKey then

            visible = not visible

            if visible then

                Main.Visible = true

                Main.Size = UDim2.fromOffset(
                    Main.AbsoluteSize.X,
                    Main.AbsoluteSize.Y
                )

                Tween(Main, Z3US.TweenSlow, {
                    BackgroundTransparency = 0
                })

            else

                Tween(Main, Z3US.TweenSlow, {
                    BackgroundTransparency = 1
                })

                task.delay(0.3, function()

                    if not visible then
                        Main.Visible = false
                    end
                end)
            end
        end
    end)

    --========================================================
    -- NOTIFICATIONS
    --========================================================

    local NotificationHolder = New("Frame", {
        Name = "Notifications",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -15, 1, -15),
        Size = UDim2.fromOffset(300, 400),
        BackgroundTransparency = 1,
        Parent = ScreenGui
    })

    local NotificationLayout = New("UIListLayout", {
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        Padding = UDim.new(0, 8),
        Parent = NotificationHolder
    })

    function Window:Notify(options)

        options = options or {}

        local notification = New("Frame", {
            Size = UDim2.fromOffset(285, 70),
            BackgroundColor3 = Z3US.Theme.Card,
            BorderSizePixel = 0,
            BackgroundTransparency = 1,
            Parent = NotificationHolder
        })

        Corner(notification, 8)
        Stroke(notification, Z3US.Theme.Stroke, 1, 0.3)

        local accent = New("Frame", {
            Position = UDim2.fromOffset(0, 8),
            Size = UDim2.fromOffset(3, 54),
            BackgroundColor3 = options.Color or Z3US.Theme.Accent,
            BorderSizePixel = 0,
            Parent = notification
        })

        Corner(accent, 2)

        local title = New("TextLabel", {
            Position = UDim2.fromOffset(14, 10),
            Size = UDim2.new(1, -25, 0, 18),
            BackgroundTransparency = 1,
            Text = options.Title or "Notification",
            TextColor3 = Z3US.Theme.Text,
            TextSize = 12,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = notification
        })

        local message = New("TextLabel", {
            Position = UDim2.fromOffset(14, 31),
            Size = UDim2.new(1, -25, 0, 28),
            BackgroundTransparency = 1,
            Text = options.Content or "",
            TextColor3 = Z3US.Theme.SubText,
            TextSize = 10,
            Font = Z3US.Font,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = notification
        })

        notification.Position = UDim2.new(1, 25, 0, 0)

        Tween(notification, Z3US.TweenSlow, {
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 0
        })

        task.delay(options.Duration or 3, function()

            if notification.Parent then

                local tween = Tween(
                    notification,
                    Z3US.TweenSlow,
                    {
                        Position = UDim2.new(1, 25, 0, 0),
                        BackgroundTransparency = 1
                    }
                )

                tween.Completed:Connect(function()
                    notification:Destroy()
                end)
            end
        end)
    end

    --========================================================
    -- THEME
    --========================================================

    function Window:SetTheme(theme)

        if not theme then
            return
        end

        for key, value in pairs(theme) do
            if Z3US.Theme[key] ~= nil then
                Z3US.Theme[key] = value
            end
        end

        Main.BackgroundColor3 = Z3US.Theme.Background
        Content.BackgroundColor3 = Z3US.Theme.Background
        Sidebar.BackgroundColor3 = Z3US.Theme.Sidebar
        TitleBar.BackgroundColor3 = Z3US.Theme.Background2
    end

    --========================================================
    -- DESTROY
    --========================================================

    function Window:Destroy()

        if ScreenGui then
            ScreenGui:Destroy()
        end
    end

    return Window
end

return Z3US
