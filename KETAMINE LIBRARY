            --================================================
            -- SLIDER
            --================================================

            function Section:CreateSlider(options)

                options = options or {}

                local SliderObject = {}

                local Minimum =
                    options.Min or 0

                local Maximum =
                    options.Max or 100

                local Value =
                    math.clamp(
                        options.Default
                        or Minimum,

                        Minimum,
                        Maximum
                    )

                local Row = Create(
                    "Frame",
                    {

                        Parent = Controls,

                        BackgroundTransparency = 1,

                        Size = UDim2.new(
                            1,
                            0,
                            0,
                            45
                        ),

                        ZIndex = 17
                    }
                )

                local Label = Create(
                    "TextLabel",
                    {

                        Parent = Row,

                        BackgroundTransparency = 1,

                        Size = UDim2.new(
                            1,
                            -45,
                            0,
                            18
                        ),

                        Font =
                            Enum.Font.SourceSansBold,

                        Text =
                            options.Name
                            or "Slider",

                        TextColor3 =
                            Library.Theme.Text,

                        TextSize = 11,

                        TextXAlignment =
                            Enum.TextXAlignment.Left,

                        ZIndex = 18
                    }
                )

                local ValueLabel = Create(
                    "TextLabel",
                    {

                        Parent = Row,

                        BackgroundTransparency = 1,

                        Position =
                            UDim2.new(
                                1,
                                -45,
                                0,
                                0
                            ),

                        Size =
                            UDim2.fromOffset(
                                45,
                                18
                            ),

                        Font =
                            Enum.Font.SourceSans,

                        Text =
                            tostring(Value),

                        TextColor3 =
                            Library.Theme.TextBright,

                        TextSize = 10,

                        TextXAlignment =
                            Enum.TextXAlignment.Right,

                        ZIndex = 18
                    }
                )

                local Bar = Create(
                    "Frame",
                    {

                        Parent = Row,

                        BackgroundColor3 =
                            Color3.fromRGB(
                                72,
                                72,
                                72
                            ),

                        BorderSizePixel = 0,

                        Position =
                            UDim2.fromOffset(
                                0,
                                29
                            ),

                        Size =
                            UDim2.new(
                                1,
                                0,
                                0,
                                4
                            ),

                        ZIndex = 18
                    }
                )

                Corner(Bar, 3)

                local Fill = Create(
                    "Frame",
                    {

                        Parent = Bar,

                        BackgroundColor3 =
                            Library.Theme.Accent,

                        BorderSizePixel = 0,

                        Size =
                            UDim2.new(
                                0,
                                0,
                                1,
                                0
                            ),

                        ZIndex = 19
                    }
                )

                Corner(Fill, 3)

                local Knob = Create(
                    "Frame",
                    {

                        Parent = Bar,

                        BackgroundColor3 =
                            Library.Theme.Accent,

                        BorderSizePixel = 0,

                        AnchorPoint =
                            Vector2.new(
                                0.5,
                                0.5
                            ),

                        Position =
                            UDim2.new(
                                0,
                                0,
                                0.5,
                                0
                            ),

                        Size =
                            UDim2.fromOffset(
                                11,
                                11
                            ),

                        ZIndex = 20
                    }
                )

                Corner(Knob, 6)

                local sliderDragging = false

                local function SetSlider(
                    mouseX,
                    fireCallback
                )

                    local barPosition =
                        Bar.AbsolutePosition

                    local barSize =
                        Bar.AbsoluteSize

                    local percentage =
                        math.clamp(

                            (
                                mouseX
                                - barPosition.X
                            )
                            / barSize.X,

                            0,
                            1
                        )

                    Value =
                        Minimum
                        + (
                            Maximum
                            - Minimum
                        )
                        * percentage

                    if options.Rounding then

                        local rounding =
                            options.Rounding

                        Value =
                            math.floor(
                                Value
                                * rounding
                                + 0.5
                            )
                            / rounding

                    else

                        Value =
                            math.floor(
                                Value
                                + 0.5
                            )

                    end

                    local normalized =
                        (
                            Value
                            - Minimum
                        )
                        / (
                            Maximum
                            - Minimum
                        )

                    Fill.Size =
                        UDim2.new(
                            normalized,
                            0,
                            1,
                            0
                        )

                    Knob.Position =
                        UDim2.new(
                            normalized,
                            0,
                            0.5,
                            0
                        )

                    ValueLabel.Text =
                        tostring(Value)

                    if fireCallback
                        and options.Callback then

                        options.Callback(
                            Value
                        )

                    end

                end

                local function BeginSlider(
                    input
                )

                    if input.UserInputType
                        ~= Enum.UserInputType.MouseButton1
                        and input.UserInputType
                        ~= Enum.UserInputType.Touch then

                        return

                    end

                    sliderDragging = true

                    SetSlider(
                        input.Position.X,
                        true
                    )

                end

                Bar.InputBegan:Connect(
                    BeginSlider
                )

                Knob.InputBegan:Connect(
                    BeginSlider
                )

                UserInputService.InputChanged:Connect(
                    function(input)

                        if not sliderDragging then
                            return
                        end

                        if input.UserInputType
                            == Enum.UserInputType.MouseMovement
                            or input.UserInputType
                            == Enum.UserInputType.Touch then

                            SetSlider(
                                input.Position.X,
                                true
                            )

                        end

                    end
                )

                UserInputService.InputEnded:Connect(
                    function(input)

                        if input.UserInputType
                            == Enum.UserInputType.MouseButton1
                            or input.UserInputType
                            == Enum.UserInputType.Touch then

                            sliderDragging = false

                        end

                    end
                )

                function SliderObject:SetValue(
                    newValue
                )

                    Value =
                        math.clamp(
                            newValue,
                            Minimum,
                            Maximum
                        )

                    local normalized =
                        (
                            Value
                            - Minimum
                        )
                        / (
                            Maximum
                            - Minimum
                        )

                    Fill.Size =
                        UDim2.new(
                            normalized,
                            0,
                            1,
                            0
                        )

                    Knob.Position =
                        UDim2.new(
                            normalized,
                            0,
                            0.5,
                            0
                        )

                    ValueLabel.Text =
                        tostring(Value)

                    if options.Callback then

                        options.Callback(
                            Value
                        )

                    end

                end

                function SliderObject:GetValue()

                    return Value

                end

                -- Set initial position without
                -- firing the callback.

                local initial =
                    (
                        Value
                        - Minimum
                    )
                    / (
                        Maximum
                        - Minimum
                    )

                Fill.Size =
                    UDim2.new(
                        initial,
                        0,
                        1,
                        0
                    )

                Knob.Position =
                    UDim2.new(
                        initial,
                        0,
                        0.5,
                        0
                    )

                return SliderObject

            end

            --================================================
            -- LABEL
            --================================================

            function Section:CreateLabel(
                text
            )

                local Label = Create(
                    "TextLabel",
                    {

                        Parent = Controls,

                        BackgroundTransparency = 1,

                        Size = UDim2.new(
                            1,
                            0,
                            0,
                            22
                        ),

                        Font =
                            Enum.Font.SourceSansBold,

                        Text =
                            text or "",

                        TextColor3 =
                            Library.Theme.Text,

                        TextSize = 11,

                        TextXAlignment =
                            Enum.TextXAlignment.Left,

                        ZIndex = 17
                    }
                )

                return Label

            end

            table.insert(
                Tab.Sections,
                Section
            )

            return Section

        end

        --====================================================
        -- ACTIVATE TAB
        --====================================================

        local function ActivateTab()

            for _, OtherTab in ipairs(
                Window.Tabs
            ) do

                OtherTab.Page.Visible = false

                Tween(
                    OtherTab.Button,
                    {
                        BackgroundColor3 =
                            Color3.fromRGB(
                                48,
                                48,
                                48
                            )
                    }
                )

            end

            Tab.Page.Visible = true

            Tween(
                Tab.Button,
                {
                    BackgroundColor3 =
                        Color3.fromRGB(
                            65,
                            65,
                            65
                        )
                }
            )

            Window.ActiveTab = Tab

        end

        TabButton.MouseButton1Click:Connect(
            ActivateTab
        )

        table.insert(
            Window.Tabs,
            Tab
        )

        -- First tab opens automatically.

        if #Window.Tabs == 1 then
            ActivateTab()
        end

        return Tab

    end

    --========================================================
    -- WINDOW METHODS
    --========================================================

    function Window:SetTitle(
        newTitle
    )

        Title.Text =
            tostring(newTitle)

    end

    function Window:Destroy()

        ScreenGui:Destroy()

    end

    return Window

end

--============================================================
-- RETURN
--============================================================

return Library
