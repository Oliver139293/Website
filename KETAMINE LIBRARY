--// =========================================================
--//                     SIMPLE UI LIBRARY
--// =========================================================
--//
--// Structure:
--//
--// Window
--//   ├── Tab 1
--//   │    ├── Invisible Left Column
--//   │    └── Invisible Right Column
--//   │
--//   ├── Tab 2
--//   │    ├── Invisible Left Column
--//   │    └── Invisible Right Column
--//   │
--//   └── Tab 3
--//        ├── Invisible Left Column
--//        └── Invisible Right Column
--//
--// Controls automatically position themselves.
--// No cheat/gameplay functionality is included.
--//
--// =========================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

local Library = {}

--============================================================
-- THEME
--============================================================

Library.Theme = {
    Background = Color3.fromRGB(49, 49, 49),
    Container = Color3.fromRGB(33, 33, 33),
    Element = Color3.fromRGB(39, 39, 39),

    Border = Color3.fromRGB(75, 75, 75),

    Accent = Color3.fromRGB(150, 190, 255),

    Text = Color3.fromRGB(207, 207, 207),
    TextBright = Color3.fromRGB(230, 230, 230),

    MutedText = Color3.fromRGB(145, 145, 145),
}

Library.TweenInfo = TweenInfo.new(
    0.12,
    Enum.EasingStyle.Quad,
    Enum.EasingDirection.Out
)

--============================================================
-- HELPERS
--============================================================

local function Create(className, properties)

    local object = Instance.new(className)

    for property, value in pairs(properties or {}) do
        object[property] = value
    end

    return object
end

local function Corner(parent, radius)

    return Create("UICorner", {
        Parent = parent,
        CornerRadius = UDim.new(0, radius or 3)
    })

end

local function Stroke(parent, color, thickness)

    return Create("UIStroke", {
        Parent = parent,
        Color = color or Library.Theme.Border,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    })

end

local function Tween(object, properties)

    TweenService:Create(
        object,
        Library.TweenInfo,
        properties
    ):Play()

end

