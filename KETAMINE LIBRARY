                    TextColor3 = Z3US.Theme.Accent,
                    TextSize = 11,
                    Font = Z3US.Font,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Parent = holder
                })

                local Track = New("Frame", {
                    Position = UDim2.new(0, 12, 0, 42),
                    Size = UDim2.new(1, -24, 0, 5),
                    BackgroundColor3 = Z3US.Theme.ToggleOff,
                    BorderSizePixel = 0,
                    Parent = holder
                })

                Corner(Track, 3)

                local Fill = New("Frame", {
                    Size = UDim2.new(
                        (value - min) / (max - min),
                        0,
                        1,
                        0
                    ),
                    BackgroundColor3 = Z3US.Theme.Accent,
                    BorderSizePixel = 0,
                    Parent = Track
                })

                Corner(Fill, 3)

                local Knob = New("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(
                        (value - min) / (max - min),
                        0,
                        0.5,
                        0
                    ),
                    Size = UDim2.fromOffset(12, 12),
                    BackgroundColor3 = Z3US.Theme.Text,
                    BorderSizePixel = 0,
                    Parent = Track
                })

                Corner(Knob, 6)

                local dragging = false

                local function SetValueFromX(x)

                    local percent = math.clamp(
                        (x - Track.AbsolutePosition.X) /
                        Track.AbsoluteSize.X,
                        0,
                        1
                    )

                    value = min + ((max - min) * percent)

                    if options.Rounding then
                        local power = 10 ^ options.Rounding
                        value = math.floor(value * power + 0.5) / power
                    else
                        value = math.floor(value + 0.5)
                    end

                    local normalized = (value - min) / (max - min)

                    Fill.Size = UDim2.new(normalized, 0, 1, 0)

                    Tween(Knob, Z3US.TweenFast, {
                        Position = UDim2.new(normalized, 0, 0.5, 0)
                    })

                    ValueLabel.Text = tostring(value)

                    if options.Callback then
                        task.spawn(options.Callback, value)
                    end
                end

                Track.InputBegan:Connect(function(input)

                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then

                        dragging = true
                        SetValueFromX(input.Position.X)
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)

                    if dragging then

                        if input.UserInputType == Enum.UserInputType.MouseMovement
                            or input.UserInputType == Enum.UserInputType.Touch then

                            SetValueFromX(input.Position.X)
                        end
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)

                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then

                        dragging = false
                    end
                end)

                function Slider:Set(newValue)

                    value = math.clamp(newValue, min, max)

                    local normalized = (value - min) / (max - min)

                    Fill.Size = UDim2.new(normalized, 0, 1, 0)

                    Knob.Position = UDim2.new(
                        normalized,
                        0,
                        0.5,
                        0
                    )

                    ValueLabel.Text = tostring(value)

                    if options.Callback then
                        task.spawn(options.Callback, value)
                    end
                end

                function Slider:Get()
                    return value
                end

                return Slider
            end

            --================================================
            -- DROPDOWN
            --================================================

            function Section:CreateDropdown(options)

                options = options or {}

                local Dropdown = {}

                local values = options.Values or {}
                local selected = options.Default or values[1]

                local holder = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 47),
                    BackgroundColor3 = Z3US.Theme.Card,
                    BorderSizePixel = 0,
                    ClipsDescendants = true,
                    Parent = SectionContainer
                })

                Corner(holder, 7)

                local Button = New("TextButton", {
                    Size = UDim2.new(1, 0, 0, 47),
                    BackgroundTransparency = 1,
                    Text = "",
                    AutoButtonColor = false,
                    Parent = holder
                })

                local Name = New("TextLabel", {
                    Position = UDim2.fromOffset(12, 0),
                    Size = UDim2.new(0.5, 0, 0, 47),
                    BackgroundTransparency = 1,
                    Text = options.Name or "Dropdown",
                    TextColor3 = Z3US.Theme.Text,
                    TextSize = 12,
                    Font = Z3US.Font,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Button
                })

                local Selected = New("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, -35, 0, 0),
                    Size = UDim2.new(0.4, 0, 0, 47),
                    BackgroundTransparency = 1,
                    Text = tostring(selected or "--"),
                    TextColor3 = Z3US.Theme.SubText,
                    TextSize = 11,
                    Font = Z3US.Font,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Parent = Button
                })

                local Arrow = New("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, -10, 0, 0),
                    Size = UDim2.fromOffset(20, 47),
                    BackgroundTransparency = 1,
                    Text = "⌄",
                    TextColor3 = Z3US.Theme.SubText,
                    TextSize = 15,
                    Font = Z3US.Font,
                    Parent = Button
                })

                local List = New("Frame", {
                    Position = UDim2.fromOffset(8, 50),
                    Size = UDim2.new(1, -16, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Parent = holder
                })

                local ListLayout = New("UIListLayout", {
                    Padding = UDim.new(0, 3),
                    Parent = List
                })

                local opened = false

                local function Rebuild()

                    for _, child in ipairs(List:GetChildren()) do
                        if child:IsA("TextButton") then
                            child:Destroy()
                        end
                    end

                    for _, option in ipairs(values) do

                        local OptionButton = New("TextButton", {
                            Size = UDim2.new(1, 0, 0, 32),
                            BackgroundColor3 = Z3US.Theme.Background2,
                            BorderSizePixel = 0,
                            Text = tostring(option),
                            TextColor3 = Z3US.Theme.SubText,
                            TextSize = 11,
                            Font = Z3US.Font,
                            AutoButtonColor = false,
                            Parent = List
                        })

                        Corner(OptionButton, 5)

                        Hover(
                            OptionButton,
                            Z3US.Theme.Background2,
                            Z3US.Theme.CardHover
                        )

                        OptionButton.MouseButton1Click:Connect(function()

                            selected = option
                            Selected.Text = tostring(option)

                            opened = false

                            Tween(holder, Z3US.Tween, {
                                Size = UDim2.new(1, 0, 0, 47)
                            })

                            Tween(Arrow, Z3US.TweenFast, {
                                Rotation = 0
                            })

                            if options.Callback then
                                task.spawn(options.Callback, selected)
                            end
                        end)
                    end
                end

                Button.MouseButton1Click:Connect(function()

                    opened = not opened

                    if opened then

                        local height =
                            55 +
                            (#values * 35)

                        Tween(holder, Z3US.Tween, {
                            Size = UDim2.new(1, 0, 0, height)
                        })

                        Tween(Arrow, Z3US.TweenFast, {
                            Rotation = 180
                        })

                    else

                        Tween(holder, Z3US.Tween, {
                            Size = UDim2.new(1, 0, 0, 47)
                        })

                        Tween(Arrow, Z3US.TweenFast, {
                            Rotation = 0
                        })
                    end
                end)

                Rebuild()

                function Dropdown:Set(value)

                    if table.find(values, value) then
                        selected = value
                        Selected.Text = tostring(value)

                        if options.Callback then
                            task.spawn(options.Callback, value)
                        end
                    end
                end

                function Dropdown:Get()
                    return selected
                end

                function Dropdown:SetValues(newValues)

                    values = newValues or {}

                    Rebuild()
                end

                return Dropdown
            end

            --================================================
            -- TEXTBOX
            --================================================

            function Section:CreateTextbox(options)

                options = options or {}

                local Textbox = {}

                local holder = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 58),
                    BackgroundColor3 = Z3US.Theme.Card,
                    BorderSizePixel = 0,
                    Parent = SectionContainer
                })

                Corner(holder, 7)

                local Name = New("TextLabel", {
                    Position = UDim2.fromOffset(12, 7),
                    Size = UDim2.new(0.4, 0, 0, 17),
                    BackgroundTransparency = 1,
                    Text = options.Name or "Textbox",
                    TextColor3 = Z3US.Theme.Text,
                    TextSize = 12,
                    Font = Z3US.Font,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = holder
                })

                local Box = New("TextBox", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.fromOffset(190, 34),
                    BackgroundColor3 = Z3US.Theme.Background2,
                    BorderSizePixel = 0,
                    Text = options.Default or "",
                    PlaceholderText = options.Placeholder or "Enter text...",
                    PlaceholderColor3 = Z3US.Theme.SubText,
                    TextColor3 = Z3US.Theme.Text,
                    TextSize = 11,
                    Font = Z3US.Font,
                    ClearTextOnFocus = false,
                    Parent = holder
                })

                Corner(Box, 6)
                Stroke(Box, Z3US.Theme.Stroke, 1, 0.4)

                Box.FocusLost:Connect(function()

