            --================================================

            function Section:CreateToggle(options)

                options = options or {}

                local Toggle = {}

                local value =
                    options.Default == true

                local Row = Create(
                    "Frame",
                    {

                        Parent = Controls,

                        BackgroundTransparency = 1,

                        Size = UDim2.new(
                            1,
                            0,
                            0,
                            24
                        ),

                        ZIndex = 17
                    }
                )

                local Button = Create(
                    "TextButton",
                    {

                        Parent = Row,

                        BackgroundColor3 =
                            Library.Theme.Element,

                        BorderSizePixel = 0,

                        Position =
                            UDim2.fromOffset(
                                0,
                                5
                            ),

                        Size =
                            UDim2.fromOffset(
                                14,
                                14
                            ),

                        Text = "",

                        AutoButtonColor =
                            false,

                        ZIndex = 18
                    }
                )

                Stroke(
                    Button,
                    Library.Theme.Accent,
                    0.6
                )

                local Fill = Create(
                    "Frame",
                    {

                        Parent = Button,

                        BackgroundColor3 =
                            Library.Theme.Accent,

                        BorderSizePixel = 0,

                        Position =
                            UDim2.fromOffset(
                                2,
                                2
                            ),

                        Size =
                            UDim2.fromOffset(
                                0,
                                0
                            ),

                        ZIndex = 19
                    }
                )

                local Label = Create(
                    "TextLabel",
                    {

                        Parent = Row,

                        BackgroundTransparency = 1,

                        Position =
                            UDim2.fromOffset(
                                22,
                                0
                            ),

                        Size = UDim2.new(
                            1,
                            -22,
                            1,
                            0
                        ),

                        Font =
                            Enum.Font.SourceSansBold,

                        Text =
                            options.Name
                            or "Toggle",

                        TextColor3 =
                            Library.Theme.Text,

                        TextSize = 12,

                        TextXAlignment =
                            Enum.TextXAlignment.Left,

                        ZIndex = 18
                    }
                )

                local function SetValue(
                    newValue,
                    fireCallback
                )

                    value =
                        newValue == true

                    if value then

                        Tween(
                            Fill,
                            {
                                Size =
                                    UDim2.fromOffset(
                                        10,
                                        10
                                    )
                            }
                        )

                    else

                        Tween(
                            Fill,
                            {
                                Size =
                                    UDim2.fromOffset(
                                        0,
                                        0
                                    )
                            }
                        )

                    end

                    if fireCallback
                        and options.Callback then

                        options.Callback(value)

                    end

                end

                Button.MouseButton1Click:Connect(
                    function()

                        SetValue(
                            not value,
                            true
                        )

                    end
                )

                function Toggle:SetValue(
                    newValue
                )

                    SetValue(
                        newValue,
                        true
                    )

                end

                function Toggle:GetValue()

                    return value

                end

                SetValue(value, false)

                return Toggle

            end

