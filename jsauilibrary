        Parent = ScreenGui,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 6)
        }),

        Create("UIStroke", {
            Color = Theme.Stroke,
            Thickness = 1,
        }),
    })

    local MainStroke =
        Main:FindFirstChildOfClass("UIStroke")

    --=====================================================================
    -- TITLE BAR
    --=====================================================================

    local TitleBar = Create("Frame", {
        Name = "TitleBar",
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Theme.Secondary,
        BackgroundTransparency = UISettings.Transparency,
        BorderSizePixel = 0,
        Parent = Main,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 6)
        }),
    })

    Create("Frame", {
        Size = UDim2.new(1, 0, 0, 6),
        Position = UDim2.new(0, 0, 1, -6),
        BackgroundColor3 = Theme.Secondary,
        BackgroundTransparency = UISettings.Transparency,
        BorderSizePixel = 0,
        Parent = TitleBar,
    })

    --=====================================================================
    -- TITLE
    --=====================================================================

    local TitleLabel = Create("TextLabel", {
        Text = title or "Window",
        Font = Theme.FontBold,
        TextSize = 14,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -100, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = TitleBar,
    })

    --=====================================================================
    -- MINIMIZE
    --=====================================================================

    local MinimizeBtn = Create("TextButton", {
        Size = UDim2.new(0, 22, 0, 22),
        Position = UDim2.new(1, -54, 0.5, -11),
        BackgroundColor3 = Theme.Stroke,
        AutoButtonColor = false,
        Text = "−",
        Font = Theme.FontBold,
        TextSize = 16,
        TextColor3 = Theme.SubText,
        Parent = TitleBar,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4)
        }),
    })

    --=====================================================================
    -- CLOSE
    --=====================================================================

    local CloseBtn = Create("TextButton", {
        Size = UDim2.new(0, 22, 0, 22),
        Position = UDim2.new(1, -28, 0.5, -11),
        BackgroundColor3 = Theme.Stroke,
        AutoButtonColor = false,
        Text = "X",
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.SubText,
        Parent = TitleBar,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4)
        }),
    })

    --=====================================================================
    -- BUTTON HOVER
    --=====================================================================

    MinimizeBtn.MouseEnter:Connect(function()

        TweenService:Create(
            MinimizeBtn,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Theme.ElementBG,
                TextColor3 = Theme.Text
            }
        ):Play()

    end)

    MinimizeBtn.MouseLeave:Connect(function()

        TweenService:Create(
            MinimizeBtn,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Theme.Stroke,
                TextColor3 = Theme.SubText
            }
        ):Play()

    end)

    CloseBtn.MouseEnter:Connect(function()

        TweenService:Create(
            CloseBtn,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 =
                    Color3.fromRGB(170, 60, 60),

                TextColor3 =
                    Color3.fromRGB(255, 255, 255)
            }
        ):Play()

    end)

    CloseBtn.MouseLeave:Connect(function()

        TweenService:Create(
            CloseBtn,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Theme.Stroke,
                TextColor3 = Theme.SubText
            }
        ):Play()

    end)

    CloseBtn.MouseButton1Click:Connect(function()
        ScreenGui.Enabled = false
    end)

    --=====================================================================
    -- MINIMIZE ANIMATION
    --=====================================================================

    local minimized = false

    local NormalSize =
        UDim2.new(0, 460, 0, 300)

    local MinimizedSize =
        UDim2.new(0, 460, 0, 32)

    local MinimizeTweenInfo =
        TweenInfo.new(
            0.3,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        )

    local function SetMinimized(state)

        minimized = state

        if minimized then

            MinimizeBtn.Text = "+"

            TweenService:Create(
                Main,
                MinimizeTweenInfo,
                {
                    Size = MinimizedSize
                }
            ):Play()

        else

            MinimizeBtn.Text = "−"

            TweenService:Create(
                Main,
                MinimizeTweenInfo,
                {
                    Size = NormalSize
                }
            ):Play()

        end
    end

    MinimizeBtn.MouseButton1Click:Connect(function()
        SetMinimized(not minimized)
    end)

    --=====================================================================
    -- DRAG
    --=====================================================================

    MakeDraggable(
        TitleBar,
        Main
    )

    --=====================================================================
    -- TAB BAR
    --=====================================================================

    local TabBar = Create("Frame", {
        Name = "TabBar",
        Size = UDim2.new(0, 110, 1, -32),
        Position = UDim2.new(0, 0, 0, 32),
        BackgroundColor3 = Theme.Secondary,
        BackgroundTransparency = UISettings.Transparency,
        BorderSizePixel = 0,
        Parent = Main,
    }, {
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 2),
        }),

        Create("UIPadding", {
            PaddingTop = UDim.new(0, 6),
            PaddingLeft = UDim.new(0, 4),
            PaddingRight = UDim.new(0, 4),
        }),
    })

    --=====================================================================
    -- CONTENT
    --=====================================================================

    local ContentArea = Create("Frame", {
        Name = "ContentArea",
        Size = UDim2.new(1, -110, 1, -32),
        Position = UDim2.new(0, 110, 0, 32),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = UISettings.Transparency,
        BorderSizePixel = 0,
        Parent = Main,
    })

    --=====================================================================
    -- DATA
    --=====================================================================

    self.ScreenGui = ScreenGui
    self.Main = Main
    self.TitleBar = TitleBar
    self.TabBar = TabBar
    self.ContentArea = ContentArea
    self.Tabs = {}
    self.ActiveTab = nil
    self._ThemeObjects = {}

    --=====================================================================
    -- REGISTER THEME OBJECTS
    --=====================================================================

    local function RegisterThemeObject(object)

        table.insert(
            self._ThemeObjects,
            object
        )

        return object
    end

    RegisterThemeObject(Main)
    RegisterThemeObject(TitleBar)
    RegisterThemeObject(TabBar)
    RegisterThemeObject(ContentArea)

    --=====================================================================
    -- APPLY THEME
    --=====================================================================

    function self:ApplyTheme()

        -- Main
        Main.BackgroundColor3 =
            Theme.Background

        Main.BackgroundTransparency =
            UISettings.Transparency

        -- Stroke
        if MainStroke then

            MainStroke.Color =
                Theme.Stroke

        end

        -- Title bar
        TitleBar.BackgroundColor3 =
            Theme.Secondary

        TitleBar.BackgroundTransparency =
            UISettings.Transparency

        TitleLabel.TextColor3 =
            Theme.Text

        -- Buttons
        MinimizeBtn.BackgroundColor3 =
            Theme.Stroke

        MinimizeBtn.TextColor3 =
            Theme.SubText

        CloseBtn.BackgroundColor3 =
            Theme.Stroke

        CloseBtn.TextColor3 =
            Theme.SubText

        -- Tabs
        TabBar.BackgroundColor3 =
            Theme.Secondary

        TabBar.BackgroundTransparency =
            UISettings.Transparency

        -- Content
        ContentArea.BackgroundColor3 =
            Theme.Background

        ContentArea.BackgroundTransparency =
            UISettings.Transparency

        -- Every registered object
        for _, object in ipairs(self._ThemeObjects) do

            if object
                and object.Parent
                and object._Theme then

                object:_Theme()

            end

        end
    end

    --=====================================================================
    -- CHANGE THEME
    --=====================================================================

    function self:SetTheme(themeName)

        local preset =
            ThemePresets[themeName]

        if not preset then
            return
        end

        UISettings.ThemeName =
            themeName

        for property, value in pairs(preset) do
            Theme[property] = value
        end

        self:ApplyTheme()
    end

    --=====================================================================
    -- SET TRANSPARENCY
    --=====================================================================

    function self:SetTransparency(value)

        UISettings.Transparency =
            math.clamp(value, 0, 0.9)

        self:ApplyTheme()

    end

    return self
end

--=========================================================================
-- SELECT TAB
--=========================================================================
function Library:SelectTab(tab)

    for _, t in ipairs(self.Tabs) do

        local active =
            t == tab

        t.Content.Visible =
            active

        t.Button.BackgroundColor3 =
            active
            and Theme.Accent
            or Theme.Secondary

        t.Button.TextColor3 =
            active
            and Color3.fromRGB(255, 255, 255)
            or Theme.SubText

    end

    self.ActiveTab = tab
end

--=========================================================================
-- CREATE TAB
--=========================================================================
function Library:CreateTab(name)

    local TabButton = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = Theme.Secondary,
        BackgroundTransparency = UISettings.Transparency,
        AutoButtonColor = false,
        Text = name,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.SubText,
        Parent = self.TabBar,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4)
        }),
    })

    local TabContent = Create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = self.ContentArea,
    }, {
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 6),
        }),

        Create("UIPadding", {
            PaddingTop = UDim.new(0, 8),
            PaddingLeft = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 8),
            PaddingBottom = UDim.new(0, 8),
        }),
    })

    local Tab = {
        Button = TabButton,
        Content = TabContent,
    }

    -- Theme updater for this tab
    Tab._Theme = function()

        TabButton.BackgroundTransparency =
            UISettings.Transparency

        TabButton.BackgroundColor3 =
            (self.ActiveTab == Tab)
            and Theme.Accent
            or Theme.Secondary

        TabButton.TextColor3 =
            (self.ActiveTab == Tab)
            and Color3.fromRGB(255, 255, 255)
            or Theme.SubText

        TabContent.ScrollBarImageColor3 =
            Theme.Accent

    end

    table.insert(
        self.Tabs,
        Tab
    )

    table.insert(
        self._ThemeObjects,
        Tab
    )

    TabButton.MouseEnter:Connect(function()

        if self.ActiveTab ~= Tab then

            TweenService:Create(
                TabButton,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 =
                        Theme.Stroke
                }
            ):Play()

        end

    end)

    TabButton.MouseLeave:Connect(function()

        if self.ActiveTab ~= Tab then

            TweenService:Create(
                TabButton,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 =
                        Theme.Secondary
                }
            ):Play()

        end

    end)

    TabButton.MouseButton1Click:Connect(function()

        self:SelectTab(Tab)

    end)

    AttachElementFunctions(
        Tab,
        TabContent
    )

    if not self.ActiveTab then
        self:SelectTab(Tab)
    end

    return Tab
end

--=========================================================================
-- CREATE SETTINGS TAB
--=========================================================================
function Library:CreateSettingsTab()

    local SettingsTab =
        self:CreateTab("Settings")

    --=====================================================================
    -- APPEARANCE DROPDOWN
    --=====================================================================

    local Appearance =
        SettingsTab:CreateDropdown("Appearance")

    --=====================================================================
    -- TRANSPARENCY
    --=====================================================================

    Appearance:CreateSlider(
        "UI Transparency",
        0,
        90,
        UISettings.Transparency * 100,
        function(value)

            self:SetTransparency(
                value / 100
            )

        end
    )

    --=====================================================================
    -- THEME DROPDOWN
    --=====================================================================

    local ThemeDropdown =
        Appearance:CreateDropdown("Themes")

    ThemeDropdown:CreateButton(
        "Dark",
        function()
            self:SetTheme("Dark")
        end
    )

    ThemeDropdown:CreateButton(
        "Purple",
        function()
            self:SetTheme("Purple")
        end
    )

    ThemeDropdown:CreateButton(
        "Red",
        function()
            self:SetTheme("Red")
        end
    )

    ThemeDropdown:CreateButton(
        "Green",
        function()
            self:SetTheme("Green")
        end
    )

    ThemeDropdown:CreateButton(
        "Ocean",
        function()
            self:SetTheme("Ocean")
        end
    )

    --=====================================================================
    -- THEME PREVIEW
    --=====================================================================

    SettingsTab:CreateButton(
        "Reset Appearance",
        function()

            self:SetTheme("Dark")
            self:SetTransparency(0)

        end
    )

    return SettingsTab
end

--=========================================================================
-- DESTROY
--=========================================================================
function Library:Destroy()

    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end

end

return Library
