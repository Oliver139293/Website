    local SliderButton = Create("TextButton", {

        Size =
            UDim2.new(1, 0, 1, 0),

        BackgroundTransparency = 1,

        Text = "",

        Parent = SliderBackground,

    })

    local dragging = false

    local function SetValue(newValue)

        value =
            math.clamp(
                newValue,
                min,
                max
            )

        value =
            math.floor(value * 100) / 100

        local percent =
            (value - min) /
            (max - min)

        SliderFill.Size =
            UDim2.new(
                percent,
                0,
                1,
                0
            )

        SliderKnob.Position =
            UDim2.new(
                percent,
                0,
                0.5,
                0
            )

        ValueLabel.Text =
            tostring(value)

        if callback then
            callback(value)
        end

    end

    local function UpdateFromMouse(x)

        local startX =
            SliderBackground.AbsolutePosition.X

        local width =
            SliderBackground.AbsoluteSize.X

        local percent =
            math.clamp(
                (x - startX) / width,
                0,
                1
            )

        SetValue(
            min +
            ((max - min) * percent)
        )

    end

    SliderButton.InputBegan:Connect(function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or input.UserInputType ==
            Enum.UserInputType.Touch then

            dragging = true

            UpdateFromMouse(
                input.Position.X
            )

        end

    end)

    UserInputService.InputChanged:Connect(function(input)

        if not dragging then
            return
        end

        if input.UserInputType ==
            Enum.UserInputType.MouseMovement
            or input.UserInputType ==
            Enum.UserInputType.Touch then

            UpdateFromMouse(
                input.Position.X
            )

        end

    end)

    UserInputService.InputEnded:Connect(function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or input.UserInputType ==
            Enum.UserInputType.Touch then

            dragging = false

        end

    end)

    local object = {

        Instance = Holder,

        Set = SetValue,

        Get = function()
            return value
        end,

    }

    object._Theme = function(info)

        TweenService:Create(
            Holder,
            info,
            {
                BackgroundColor3 =
                    Theme.ElementBG,

                BackgroundTransparency =
                    UISettings.Transparency,
            }
        ):Play()

        TweenService:Create(
            Label,
            info,
            {
                TextColor3 =
                    Theme.Text
            }
        ):Play()

        TweenService:Create(
            ValueLabel,
            info,
            {
                TextColor3 =
                    Theme.SubText
            }
        ):Play()

        TweenService:Create(
            SliderBackground,
            info,
            {
                BackgroundColor3 =
                    Theme.SwitchOff
            }
        ):Play()

        TweenService:Create(
            SliderFill,
            info,
            {
                BackgroundColor3 =
                    Theme.Accent
            }
        ):Play()

    end

    return object
end

--=========================================================================
-- DROPDOWN
--=========================================================================

CreateDropdownElement = function(
    parentFrame,
    text,
    isToggleType,
    default,
    callback
)

    local expanded = false

    local Container = Create("Frame", {

        Size =
            UDim2.new(1, 0, 0, 26),

        BackgroundColor3 =
            Theme.ElementBG,

        BackgroundTransparency =
            UISettings.Transparency,

        BorderSizePixel = 0,

        ClipsDescendants = true,

        Parent = parentFrame,

    }, {

        Create("UICorner", {
            CornerRadius =
                UDim.new(0, 4)
        }),

        Create("UIListLayout", {

            SortOrder =
                Enum.SortOrder.LayoutOrder,

        }),

    })

    local Header = Create("Frame", {

        Size =
            UDim2.new(1, 0, 0, 26),

        BackgroundTransparency = 1,

        LayoutOrder = 1,

        Parent = Container,

    })

    local ExpandBtn = Create("TextButton", {

        Size =
            UDim2.new(0, 18, 0, 18),

        Position =
            UDim2.new(0, 5, 0.5, -9),

        BackgroundColor3 =
            Theme.Stroke,

        AutoButtonColor = false,

        Text = "+",

        Font =
            Theme.FontBold,

        TextSize = 14,

        TextColor3 =
            Theme.Text,

        Parent = Header,

    }, {

        Create("UICorner", {
            CornerRadius =
                UDim.new(0, 4)
        }),

    })

    local titleRightPad =
        isToggleType
        and 90
        or 40

    local Title = Create("TextLabel", {

        Text = text,

        Font =
            Theme.Font,

        TextSize = 13,

        TextColor3 =
            Theme.Text,

        BackgroundTransparency = 1,

        Size =
            UDim2.new(
                1,
                -(28 + titleRightPad),
                1,
                0
            ),

        Position =
            UDim2.new(0, 28, 0, 0),

        TextXAlignment =
            Enum.TextXAlignment.Left,

        Parent = Header,

    })

    local dropdownObj = {}

    --=====================================================================
    -- TOGGLE DROPDOWN SWITCH
    --=====================================================================

    if isToggleType then

        local state =
            default == true

        local SwitchBG = Create("Frame", {

            Size =
                UDim2.new(0, 32, 0, 16),

            Position =
                UDim2.new(1, -40, 0.5, -8),

            BackgroundColor3 =
                state
                and Theme.Accent
                or Theme.SwitchOff,

            BackgroundTransparency =
                UISettings.Transparency,

            BorderSizePixel = 0,

            Parent = Header,

        }, {

            Create("UICorner", {
                CornerRadius =
                    UDim.new(1, 0)
            }),

        })

        local Knob = Create("Frame", {

            Size =
                UDim2.new(0, 12, 0, 12),

            Position =
                state
                and UDim2.new(1, -14, 0.5, -6)
                or UDim2.new(0, 2, 0.5, -6),

            BackgroundColor3 =
                Color3.fromRGB(255, 255, 255),

            BorderSizePixel = 0,

            Parent = SwitchBG,

        }, {

            Create("UICorner", {
                CornerRadius =
                    UDim.new(1, 0)
            }),

        })

        local SwitchClick = Create("TextButton", {

            Size =
                UDim2.new(0, 32, 0, 16),

            Position =
                UDim2.new(1, -40, 0.5, -8),

            BackgroundTransparency = 1,

            Text = "",

            Parent = Header,

        })

        local function SetState(newState)

            state =
                newState

            TweenService:Create(
                SwitchBG,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 =
                        state
                        and Theme.Accent
                        or Theme.SwitchOff
                }
            ):Play()

            TweenService:Create(
                Knob,
                TweenInfo.new(0.15),
                {
                    Position =
                        state
                        and UDim2.new(1, -14, 0.5, -6)
                        or UDim2.new(0, 2, 0.5, -6)
                }
            ):Play()

            if callback then
                callback(state)
            end

        end

        SwitchClick.MouseButton1Click:Connect(function()

            SetState(not state)

        end)

        dropdownObj.Toggle = {

            Set = SetState,

            Get = function()
                return state
            end,

        }

        dropdownObj._ToggleTheme = function(info)

            TweenService:Create(
                SwitchBG,
                info,
                {
                    BackgroundColor3 =
                        state
                        and Theme.Accent
                        or Theme.SwitchOff,

                    BackgroundTransparency =
                        UISettings.Transparency,
                }
            ):Play()

        end

    end

    --=====================================================================
    -- INNER
    --=====================================================================

    local Inner = Create("Frame", {

        Size =
            UDim2.new(1, 0, 0, 0),

        BackgroundTransparency = 1,

        Visible = false,

        LayoutOrder = 2,

        ClipsDescendants = true,

        Parent = Container,

    }, {

        Create("UIListLayout", {

            SortOrder =
                Enum.SortOrder.LayoutOrder,

            Padding =
                UDim.new(0, 4),

        }),

        Create("UIPadding", {

            PaddingLeft =
                UDim.new(0, 14),

            PaddingRight =
                UDim.new(0, 4),

            PaddingTop =
                UDim.new(0, 4),

            PaddingBottom =
                UDim.new(0, 6),

        }),

    })

    local InnerLayout =
        Inner:FindFirstChildOfClass(
            "UIListLayout"
        )

    local InnerPadding =
        Inner:FindFirstChildOfClass(
            "UIPadding"
        )

    --=====================================================================
    -- DROPDOWN HEIGHT
    --=====================================================================

    local function GetInnerHeight()

        local height = 0

        if InnerLayout then

            height =
                InnerLayout.AbsoluteContentSize.Y

        end

        if InnerPadding then

            height =
                height
                + InnerPadding.PaddingTop.Offset
                + InnerPadding.PaddingBottom.Offset

        end

        return height

    end

    local DropdownInfo =
        TweenInfo.new(
            0.25,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        )

    local function UpdateInnerSize(animated)

        local target =
            UDim2.new(
                1,
                0,
                0,
                GetInnerHeight()
            )

        if animated then

            TweenService:Create(
                Inner,
                DropdownInfo,
                {
                    Size = target
                }
            ):Play()

        else

            Inner.Size =
                target

        end

    end

    --=====================================================================
    -- HOVER
    --=====================================================================

    ExpandBtn.MouseEnter:Connect(function()

        TweenService:Create(
            ExpandBtn,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 =
                    Theme.Secondary
            }
        ):Play()

    end)

    ExpandBtn.MouseLeave:Connect(function()

        TweenService:Create(
            ExpandBtn,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 =
                    Theme.Stroke
            }
        ):Play()

    end)

    --=====================================================================
    -- EXPAND / COLLAPSE
    --=====================================================================

    ExpandBtn.MouseButton1Click:Connect(function()

        expanded =
            not expanded

        if expanded then

            Inner.Visible =
                true

            Inner.Size =
                UDim2.new(
                    1,
                    0,
                    0,
                    0
                )

            UpdateInnerSize(true)

            ExpandBtn.Text =
                "−"

        else

            local tween =
                TweenService:Create(
                    Inner,
                    DropdownInfo,
                    {
                        Size =
                            UDim2.new(
                                1,
                                0,
                                0,
                                0
                            )
                    }
                )

            tween:Play()

            tween.Completed:Connect(function()

                if not expanded then

                    Inner.Visible =
                        false

                end

            end)

            ExpandBtn.Text =
                "+"

        end

    end)

    --=====================================================================
    -- NESTED CONTENT SIZE UPDATE
    --=====================================================================

    if InnerLayout then

        InnerLayout:GetPropertyChangedSignal(
            "AbsoluteContentSize"
        ):Connect(function()

            if expanded then

                UpdateInnerSize(false)

            end

        end)

    end

    --=====================================================================
    -- THEME FUNCTION
    --=====================================================================

    dropdownObj._Theme = function(info)

        TweenService:Create(
            Container,
            info,
            {
                BackgroundColor3 =
                    Theme.ElementBG,

                BackgroundTransparency =
                    UISettings.Transparency,
            }
        ):Play()

        TweenService:Create(
            ExpandBtn,
            info,
            {
                BackgroundColor3 =
                    Theme.Stroke,

                TextColor3 =
                    Theme.Text,
            }
        ):Play()

        TweenService:Create(
            Title,
            info,
            {
                TextColor3 =
                    Theme.Text,
            }
        ):Play()

        if dropdownObj._ToggleTheme then

            dropdownObj._ToggleTheme(info)

        end

    end

    dropdownObj.Instance =
        Container

    dropdownObj.Inner =
        Inner

    --=====================================================================
    -- ATTACH CHILD FUNCTIONS
    --=====================================================================

    AttachElementFunctions(
        dropdownObj,
        Inner
    )

    return dropdownObj
end

--=========================================================================
-- ATTACH ELEMENT FUNCTIONS
--=========================================================================

AttachElementFunctions = function(
    obj,
    parentFrame
)

    function obj:CreateToggle(
        text,
        default,
        callback
    )

        local element =
            CreateToggleElement(
                parentFrame,
                text,
                default,
                callback
            )

        return element

    end

    function obj:CreateButton(
        text,
        callback
    )

        return CreateButtonElement(
            parentFrame,
            text,
            callback
        )

    end

    function obj:CreateSlider(
        text,
        min,
        max,
        default,
        callback
    )

        return CreateSliderElement(
            parentFrame,
            text,
            min,
            max,
            default,
            callback
        )

    end

    function obj:CreateDropdown(text)

        return CreateDropdownElement(
            parentFrame,
            text,
            false,
            nil,
            nil
        )

    end

    function obj:CreateToggleDropdown(
        text,
        default,
        callback
    )

        return CreateDropdownElement(
            parentFrame,
            text,
            true,
            default,
            callback
        )

    end

end

--=========================================================================
-- CREATE TAB
--=========================================================================

function Library:CreateTab(name)

    local TabButton = Create("TextButton", {

        Size =
            UDim2.new(1, 0, 0, 26),

        BackgroundColor3 =
            Theme.Secondary,

        BackgroundTransparency =
            UISettings.Transparency,

        AutoButtonColor = false,

        Text = name,

        Font =
            Theme.Font,

        TextSize = 13,

        TextColor3 =
            Theme.SubText,

        Parent = self.TabBar,

    }, {

        Create("UICorner", {
            CornerRadius =
                UDim.new(0, 4)
        }),

    })

    local TabContent = Create("ScrollingFrame", {

        Size =
            UDim2.new(1, 0, 1, 0),

        BackgroundTransparency = 1,

        BorderSizePixel = 0,

        ScrollBarThickness = 3,

        ScrollBarImageColor3 =
            Theme.Accent,

        CanvasSize =
            UDim2.new(0, 0, 0, 0),

        AutomaticCanvasSize =
            Enum.AutomaticSize.Y,

        Visible = false,

        Parent = self.ContentArea,

    }, {

        Create("UIListLayout", {

            SortOrder =
                Enum.SortOrder.LayoutOrder,

            Padding =
                UDim.new(0, 6),

        }),

        Create("UIPadding", {

            PaddingTop =
                UDim.new(0, 8),

            PaddingLeft =
                UDim.new(0, 8),

            PaddingRight =
                UDim.new(0, 8),

            PaddingBottom =
                UDim.new(0, 8),

        }),

    })

    local Tab = {

        Button =
            TabButton,

        Content =
            TabContent,

    }

    Tab._Theme = function(info)

        TweenService:Create(
            TabButton,
            info,
            {
                BackgroundColor3 =
                    self.ActiveTab == Tab
                    and Theme.Accent
                    or Theme.Secondary,

                BackgroundTransparency =
                    UISettings.Transparency,

                TextColor3 =
                    self.ActiveTab == Tab
                    and Color3.fromRGB(
                        255,
                        255,
                        255
                    )
                    or Theme.SubText,
            }
        ):Play()

        TweenService:Create(
            TabContent,
            info,
            {
                ScrollBarImageColor3 =
                    Theme.Accent
            }
        ):Play()

    end

    table.insert(
        self.Tabs,
        Tab
    )

    self:RegisterThemeObject(Tab)

    TabButton.MouseEnter:Connect(function()

        if self.ActiveTab ~= Tab then

            TweenService:Create(
                TabButton,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 =
                        Theme.Stroke
                }
            ):Play()

        end

    end)

    TabButton.MouseLeave:Connect(function()

        if self.ActiveTab ~= Tab then

            TweenService:Create(
                TabButton,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 =
                        Theme.Secondary
                }
            ):Play()

        end

    end)

    TabButton.MouseButton1Click:Connect(function()

        self:SelectTab(Tab)

    end)

    AttachElementFunctions(
        Tab,
        TabContent
    )

    if not self.ActiveTab then

        self:SelectTab(Tab)

    end

    return Tab
end

--=========================================================================
-- SETTINGS TAB
--=========================================================================

function Library:CreateSettingsTab()

    local SettingsTab =
        self:CreateTab("Settings")

    --=====================================================================
    -- APPEARANCE
    --=====================================================================

    local Appearance =
        SettingsTab:CreateDropdown(
            "Appearance"
        )

    --=====================================================================
    -- TRANSPARENCY
    --=====================================================================

    Appearance:CreateSlider(
        "UI Transparency",
        0,
        90,
        UISettings.Transparency * 100,

        function(value)

            self:SetTransparency(
                value / 100
            )

        end
    )

    --=====================================================================
    -- THEMES
    --=====================================================================

    local Themes =
        Appearance:CreateDropdown(
            "Themes"
        )

    Themes:CreateButton(
        "Dark",
        function()

            self:SetTheme("Dark")

        end
    )

    Themes:CreateButton(
        "Purple",
        function()

            self:SetTheme("Purple")

        end
    )

    Themes:CreateButton(
        "Red",
        function()

            self:SetTheme("Red")

        end
    )

    Themes:CreateButton(
        "Green",
        function()

            self:SetTheme("Green")

        end
    )

    Themes:CreateButton(
        "Ocean",
        function()

            self:SetTheme("Ocean")

        end
    )

    --=====================================================================
    -- RESET
    --=====================================================================

    SettingsTab:CreateButton(
        "Reset Appearance",
        function()

            self:SetTheme("Dark")

            self:SetTransparency(0)

        end
    )

    return SettingsTab
end

--=========================================================================
-- DESTROY
--=========================================================================

function Library:Destroy()

    if self.ScreenGui then

        self.ScreenGui:Destroy()

    end

end

return Library
