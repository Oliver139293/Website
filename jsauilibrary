        Name = "ContentArea",
        Size =
            UDim2.new(
                1,
                -110,
                1,
                -32
            ),
        Position =
            UDim2.new(
                0,
                110,
                0,
                32
            ),
        BackgroundColor3 =
            Theme.Background,
        BackgroundTransparency =
            UISettings.Transparency,
        BorderSizePixel = 0,
        Parent = Main,
    })

    --=====================================================================
    -- STORE
    --=====================================================================

    self.ScreenGui = ScreenGui
    self.Main = Main
    self.TitleBar = TitleBar
    self.TabBar = TabBar
    self.ContentArea = ContentArea

    self.Tabs = {}
    self.ActiveTab = nil
    self._ThemeObjects = {}

    --=====================================================================
    -- THEME OBJECTS
    --=====================================================================

    local function RegisterThemeObject(object)

        table.insert(
            self._ThemeObjects,
            object
        )

        return object

    end

    RegisterThemeObject(Main)
    RegisterThemeObject(TitleBar)
    RegisterThemeObject(TabBar)
    RegisterThemeObject(ContentArea)

    --=====================================================================
    -- APPLY THEME
    --=====================================================================

    function self:ApplyTheme()

        --=============================================================
        -- IMPORTANT:
        -- EVERYTHING HERE USES TWEEN SERVICE.
        --=============================================================

        local themeTween =
            TweenInfo.new(
                0.35,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            )

        Tween(
            Main,
            themeTween,
            {
                BackgroundColor3 =
                    Theme.Background,

                BackgroundTransparency =
                    UISettings.Transparency
            }
        )

        if MainStroke then

            Tween(
                MainStroke,
                themeTween,
                {
                    Color =
                        Theme.Stroke
                }
            )

        end

        Tween(
            TitleBar,
            themeTween,
            {
                BackgroundColor3 =
                    Theme.Secondary,

                BackgroundTransparency =
                    UISettings.Transparency
            }
        )

        Tween(
            TitleLabel,
            themeTween,
            {
                TextColor3 =
                    Theme.Text
            }
        )

        Tween(
            MinimizeBtn,
            themeTween,
            {
                BackgroundColor3 =
                    Theme.Stroke,

                TextColor3 =
                    Theme.SubText
            }
        )

        Tween(
            CloseBtn,
            themeTween,
            {
                BackgroundColor3 =
                    Theme.Stroke,

                TextColor3 =
                    Theme.SubText
            }
        )

        Tween(
            TabBar,
            themeTween,
            {
                BackgroundColor3 =
                    Theme.Secondary,

                BackgroundTransparency =
                    UISettings.Transparency
            }
        )

        Tween(
            ContentArea,
            themeTween,
            {
                BackgroundColor3 =
                    Theme.Background,

                BackgroundTransparency =
                    UISettings.Transparency
            }
        )

        --=============================================================
        -- ALL ELEMENTS
        --=============================================================

        for _, object in ipairs(
            self._ThemeObjects
        ) do

            if object
                and object.Parent
                and object._Theme then

                object:_Theme(
                    themeTween
                )

            end

        end

        --=============================================================
        -- TAB BUTTONS
        --=============================================================

        for _, tab in ipairs(
            self.Tabs
        ) do

            local active =
                self.ActiveTab == tab

            Tween(
                tab.Button,
                themeTween,
                {
                    BackgroundColor3 =
                        active
                        and Theme.Accent
                        or Theme.Secondary,

                    BackgroundTransparency =
                        UISettings.Transparency,

                    TextColor3 =
                        active
                        and Color3.fromRGB(
                            255,
                            255,
                            255
                        )
                        or Theme.SubText
                }
            )

        end

    end

    --=====================================================================
    -- SET THEME
    --=====================================================================

    function self:SetTheme(themeName)

        local preset =
            ThemePresets[themeName]

        if not preset then
            return
        end

        UISettings.ThemeName =
            themeName

        for property, value in pairs(
            preset
        ) do

            Theme[property] =
                value

        end

        self:ApplyTheme()

    end

    --=====================================================================
    -- SET TRANSPARENCY
    --=====================================================================

    function self:SetTransparency(value)

        UISettings.Transparency =
            math.clamp(
                value,
                0,
                0.9
            )

        local transparencyTween =
            TweenInfo.new(
                0.25,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            )

        -- Main
        Tween(
            Main,
            transparencyTween,
            {
                BackgroundTransparency =
                    UISettings.Transparency
            }
        )

        Tween(
            TitleBar,
            transparencyTween,
            {
                BackgroundTransparency =
                    UISettings.Transparency
            }
        )

        Tween(
            TabBar,
            transparencyTween,
            {
                BackgroundTransparency =
                    UISettings.Transparency
            }
        )

        Tween(
            ContentArea,
            transparencyTween,
            {
                BackgroundTransparency =
                    UISettings.Transparency
            }
        )

        -- Elements
        for _, object in ipairs(
            self._ThemeObjects
        ) do

            if object
                and object.Parent
                and object._Theme then

                object:_Theme(
                    transparencyTween
                )

            end

        end

    end

    return self

end

--=========================================================================
-- SELECT TAB
--=========================================================================

function Library:SelectTab(tab)

    local tweenInfo =
        TweenInfo.new(
            0.2,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        )

    for _, t in ipairs(
        self.Tabs
    ) do

        local active =
            t == tab

        t.Content.Visible =
            active

        Tween(
            t.Button,
            tweenInfo,
            {
                BackgroundColor3 =
                    active
                    and Theme.Accent
                    or Theme.Secondary,

                TextColor3 =
                    active
                    and Color3.fromRGB(
                        255,
                        255,
                        255
                    )
                    or Theme.SubText
            }
        )

    end

    self.ActiveTab = tab

end

--=========================================================================
-- CREATE TAB
--=========================================================================

function Library:CreateTab(name)

    local TabButton = Create("TextButton", {
        Size =
            UDim2.new(
                1,
                0,
                0,
                26
            ),
        BackgroundColor3 =
            Theme.Secondary,
        BackgroundTransparency =
            UISettings.Transparency,
        AutoButtonColor = false,
        Text = name,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 =
            Theme.SubText,
        Parent = self.TabBar,
    }, {

        Create("UICorner", {
            CornerRadius =
                UDim.new(0, 4)
        }),

    })

    local TabContent = Create("ScrollingFrame", {
        Size =
            UDim2.new(
                1,
                0,
                1,
                0
            ),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 =
            Theme.Accent,
        CanvasSize =
            UDim2.new(
                0,
                0,
                0,
                0
            ),
        AutomaticCanvasSize =
            Enum.AutomaticSize.Y,
        Visible = false,
        Parent = self.ContentArea,
    }, {

        Create("UIListLayout", {
            SortOrder =
                Enum.SortOrder.LayoutOrder,
            Padding =
                UDim.new(0, 6),
        }),

        Create("UIPadding", {
            PaddingTop =
                UDim.new(0, 8),
            PaddingLeft =
                UDim.new(0, 8),
            PaddingRight =
                UDim.new(0, 8),
            PaddingBottom =
                UDim.new(0, 8),
        }),

    })

    local Tab = {
        Button = TabButton,
        Content = TabContent,
    }

    --=====================================================================
    -- TAB THEME
    --=====================================================================

    Tab._Theme = function(themeTween)

        local active =
            self.ActiveTab == Tab

        Tween(
            TabButton,
            themeTween,
            {
                BackgroundColor3 =
                    active
                    and Theme.Accent
                    or Theme.Secondary,

                BackgroundTransparency =
                    UISettings.Transparency,

                TextColor3 =
                    active
                    and Color3.fromRGB(
                        255,
                        255,
                        255
                    )
                    or Theme.SubText
            }
        )

        TabContent.ScrollBarImageColor3 =
            Theme.Accent

    end

    table.insert(
        self.Tabs,
        Tab
    )

    table.insert(
        self._ThemeObjects,
        Tab
    )

    --=====================================================================
    -- TAB HOVER
    --=====================================================================

    TabButton.MouseEnter:Connect(function()

        if self.ActiveTab ~= Tab then

            Tween(
                TabButton,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 =
                        Theme.Stroke
                }
            )

        end

    end)

    TabButton.MouseLeave:Connect(function()

        if self.ActiveTab ~= Tab then

            Tween(
                TabButton,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 =
                        Theme.Secondary
                }
            )

        end

    end)

    TabButton.MouseButton1Click:Connect(function()

        self:SelectTab(Tab)

    end)

    AttachElementFunctions(
        Tab,
        TabContent
    )

    if not self.ActiveTab then

        self:SelectTab(Tab)

    end

    return Tab

end

