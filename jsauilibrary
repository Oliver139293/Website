--=========================================================================
-- TOGGLE ELEMENT
--=========================================================================
CreateToggleElement = function(parentFrame, text, default, callback)

	local state = default == true

	local Holder = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Theme.ElementBG,
		BorderSizePixel = 0,
		Parent = parentFrame,
	}, {
		Create("UICorner", {
			CornerRadius = UDim.new(0, 4)
		}),
	})

	Create("TextLabel", {
		Text = text,
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -46, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = Holder,
	})

	local SwitchBG = Create("Frame", {
		Size = UDim2.new(0, 32, 0, 16),
		Position = UDim2.new(1, -40, 0.5, -8),
		BackgroundColor3 = state and Theme.Accent or Theme.SwitchOff,
		BorderSizePixel = 0,
		Parent = Holder,
	}, {
		Create("UICorner", {
			CornerRadius = UDim.new(1, 0)
		}),
	})

	local Knob = Create("Frame", {
		Size = UDim2.new(0, 12, 0, 12),
		Position = state
			and UDim2.new(1, -14, 0.5, -6)
			or UDim2.new(0, 2, 0.5, -6),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Parent = SwitchBG,
	}, {
		Create("UICorner", {
			CornerRadius = UDim.new(1, 0)
		}),
	})

	local Click = Create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = Holder,
	})

	local function SetState(newState)

		state = newState

		TweenService:Create(
			SwitchBG,
			TweenInfo.new(0.15),
			{
				BackgroundColor3 =
					state and Theme.Accent or Theme.SwitchOff
			}
		):Play()

		TweenService:Create(
			Knob,
			TweenInfo.new(0.15),
			{
				Position =
					state
					and UDim2.new(1, -14, 0.5, -6)
					or UDim2.new(0, 2, 0.5, -6)
			}
		):Play()

		if callback then
			callback(state)
		end
	end

	Click.MouseButton1Click:Connect(function()
		SetState(not state)
	end)

	return {
		Instance = Holder,
		Set = SetState,
		Get = function()
			return state
		end,
	}
end

--=========================================================================
-- BUTTON ELEMENT
--=========================================================================
CreateButtonElement = function(parentFrame, text, callback, onSelected)

	local Holder = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Theme.ElementBG,
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		Parent = parentFrame,
	}, {
		Create("UICorner", {
			CornerRadius = UDim.new(0, 4)
		}),
	})

	local Label = Create("TextLabel", {
		Text = text,
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -10, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = Holder,
	})

	--=============================================================
	-- HOVER
	--=============================================================

	Holder.MouseEnter:Connect(function()

		-- Don't overwrite selected colour
		if Holder:GetAttribute("Selected") then
			return
		end

		TweenService:Create(
			Holder,
			TweenInfo.new(0.15),
			{
				BackgroundColor3 = Color3.fromRGB(45, 45, 50)
			}
		):Play()

	end)

	Holder.MouseLeave:Connect(function()

		-- Keep selected button highlighted
		if Holder:GetAttribute("Selected") then
			return
		end

		TweenService:Create(
			Holder,
			TweenInfo.new(0.15),
			{
				BackgroundColor3 = Theme.ElementBG
			}
		):Play()

	end)

	--=============================================================
	-- CLICK
	--=============================================================

	Holder.MouseButton1Click:Connect(function()

		-- Normal callback
		if callback then
			callback()
		end

		-- Tell dropdown that this button was selected
		if onSelected then
			onSelected(text, Holder)
		else
			-- Normal button click flash
			local flashIn = TweenService:Create(
				Holder,
				TweenInfo.new(0.1),
				{
					BackgroundColor3 = Theme.Accent
				}
			)

			flashIn:Play()

			flashIn.Completed:Connect(function()

				TweenService:Create(
					Holder,
					TweenInfo.new(0.15),
					{
						BackgroundColor3 = Theme.ElementBG
					}
				):Play()

			end)
		end
	end)

	return {
		Instance = Holder,

		SetSelected = function(selected)

			Holder:SetAttribute("Selected", selected)

			if selected then

				TweenService:Create(
					Holder,
					TweenInfo.new(0.15),
					{
						BackgroundColor3 = Theme.Accent
					}
				):Play()

				Label.TextColor3 = Color3.fromRGB(255, 255, 255)

			else

				TweenService:Create(
					Holder,
					TweenInfo.new(0.15),
					{
						BackgroundColor3 = Theme.ElementBG
					}
				):Play()

				Label.TextColor3 = Theme.Text

			end

		end,
	}
end

--=========================================================================
-- SLIDER ELEMENT
--=========================================================================
CreateSliderElement = function(parentFrame, text, minValue, maxValue, defaultValue, callback)

	minValue = tonumber(minValue) or 0
	maxValue = tonumber(maxValue) or 100
	defaultValue = tonumber(defaultValue) or minValue

	if minValue > maxValue then
		minValue, maxValue = maxValue, minValue
	end

	defaultValue = math.clamp(defaultValue, minValue, maxValue)

	local value = defaultValue

	local Holder = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 48),
		BackgroundColor3 = Theme.ElementBG,
		BorderSizePixel = 0,
		Parent = parentFrame,
	}, {
		Create("UICorner", {
			CornerRadius = UDim.new(0, 4)
		}),
	})

	--=====================================================================
	-- LABEL
	--=====================================================================

	local Label = Create("TextLabel", {
		Text = text,
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -70, 0, 24),
		Position = UDim2.new(0, 10, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = Holder,
	})

	--=====================================================================
	-- VALUE LABEL
	--=====================================================================

	local ValueLabel = Create("TextLabel", {
		Text = tostring(defaultValue),
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.SubText,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 50, 0, 24),
		Position = UDim2.new(1, -60, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = Holder,
	})

	--=====================================================================
	-- SLIDER BACKGROUND
	--=====================================================================

	local SliderBG = Create("Frame", {
		Size = UDim2.new(1, -20, 0, 6),
		Position = UDim2.new(0, 10, 0, 31),
		BackgroundColor3 = Theme.SwitchOff,
		BorderSizePixel = 0,
		Parent = Holder,
	}, {
		Create("UICorner", {
			CornerRadius = UDim.new(1, 0)
		}),
	})

	--=====================================================================
	-- SLIDER FILL
	--=====================================================================

	local percentage =
		(defaultValue - minValue) /
		(maxValue - minValue)

	local SliderFill = Create("Frame", {
		Size = UDim2.new(percentage, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = SliderBG,
	}, {
		Create("UICorner", {
			CornerRadius = UDim.new(1, 0)
		}),
	})

	--=====================================================================
	-- SLIDER KNOB
	--=====================================================================

	local Knob = Create("Frame", {
		Size = UDim2.new(0, 12, 0, 12),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(percentage, 0, 0.5, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Parent = SliderBG,
	}, {
		Create("UICorner", {
			CornerRadius = UDim.new(1, 0)
		}),
	})

	--=====================================================================
	-- CLICK / DRAG AREA
	--=====================================================================

	local SliderButton = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.new(0, 0, 0, 22),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = Holder,
	})

	local dragging = false

	--=====================================================================
	-- SET VALUE
	--=====================================================================

	local function SetValue(newValue)

		newValue = tonumber(newValue)

		if not newValue then
			return
		end

		newValue = math.clamp(
			newValue,
			minValue,
			maxValue
		)

		-- Round to nearest integer
		newValue = math.floor(newValue + 0.5)

		value = newValue

		local alpha

		if maxValue == minValue then
			alpha = 0
		else
			alpha =
				(value - minValue) /
				(maxValue - minValue)
		end

		-- Animate slider
		TweenService:Create(
			SliderFill,
			TweenInfo.new(
				0.08,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				Size = UDim2.new(alpha, 0, 1, 0)
			}
		):Play()

		TweenService:Create(
			Knob,
			TweenInfo.new(
				0.08,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				Position = UDim2.new(alpha, 0, 0.5, 0)
			}
		):Play()

		ValueLabel.Text = tostring(value)

		if callback then
			callback(value)
		end
	end

	--=====================================================================
	-- MOUSE POSITION -> VALUE
	--=====================================================================

	local function UpdateFromMouse(mouseX)

		local absolutePosition = SliderBG.AbsolutePosition.X
		local absoluteSize = SliderBG.AbsoluteSize.X

		if absoluteSize <= 0 then
			return
		end

		local alpha =
			(mouseX - absolutePosition) /
			absoluteSize

		alpha = math.clamp(alpha, 0, 1)

		local newValue =
			minValue +
			((maxValue - minValue) * alpha)

		SetValue(newValue)
	end

	--=====================================================================
	-- CLICK
	--=====================================================================

	SliderButton.MouseButton1Down:Connect(function()

		dragging = true

		UpdateFromMouse(
			UserInputService:GetMouseLocation().X
		)

	end)

	--=====================================================================
	-- DRAG
	--=====================================================================

	UserInputService.InputChanged:Connect(function(input)

		if not dragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement then

			UpdateFromMouse(
				input.Position.X
			)

		end

	end)

	--=====================================================================
	-- STOP DRAGGING
	--=====================================================================

	UserInputService.InputEnded:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end

	end)

	--=====================================================================
	-- RETURN OBJECT
	--=====================================================================

	return {
		Instance = Holder,

		Set = SetValue,

		Get = function()
			return value
		end,
	}
end

--=========================================================================
-- DROPDOWN ELEMENT
--=========================================================================
CreateDropdownElement = function(
	parentFrame,
	text,
	isToggleType,
	default,
	callback,
	defaultSelection
)

	local expanded = false

	local Container = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.ElementBG,
		BorderSizePixel = 0,
		Parent = parentFrame,
		ClipsDescendants = true,
	}, {
		Create("UICorner", {
			CornerRadius = UDim.new(0, 4)
		}),

		Create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 0),
		}),
	})

	--=====================================================================
	-- HEADER
	--=====================================================================

	local Header = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = Container,
	})

	--=====================================================================
	-- EXPAND BUTTON
	--=====================================================================

	local ExpandBtn = Create("TextButton", {
		Size = UDim2.new(0, 18, 0, 18),
		Position = UDim2.new(0, 5, 0.5, -9),
		BackgroundColor3 = Color3.fromRGB(46, 46, 51),
		AutoButtonColor = false,
		Text = "+",
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		Parent = Header,
	}, {
		Create("UICorner", {
			CornerRadius = UDim.new(0, 4)
		}),
	})

	--=====================================================================
	-- TITLE
	--=====================================================================

	local titleRightPad = isToggleType and 90 or 40

	local TitleLabel = Create("TextLabel", {
		Text = text,
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		BackgroundTransparency = 1,
		Size = UDim2.new(
			1,
			-(28 + titleRightPad),
			1,
			0
		),
		Position = UDim2.new(0, 28, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = Header,
	})

	--=============================================================
	-- SELECTED ITEM LABEL
	--=============================================================

	local SelectedLabel

	if isToggleType then

		-- Selected item sits between title and toggle
		SelectedLabel = Create("TextLabel", {
			Text = "",
			Font = Theme.Font,
			TextSize = 11,
			TextColor3 = Theme.SubText,
			BackgroundTransparency = 1,

			Size = UDim2.new(
				0,
				75,
				1,
				0
			),

			Position = UDim2.new(
				1,
				-120,
				0,
				0
			),

			TextXAlignment = Enum.TextXAlignment.Right,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = Header,
		})

	else

		-- Selected item sits on the right side
		SelectedLabel = Create("TextLabel", {
			Text = "",
			Font = Theme.Font,
			TextSize = 11,
			TextColor3 = Theme.SubText,
			BackgroundTransparency = 1,

			Size = UDim2.new(
				0,
				95,
				1,
				0
			),

			Position = UDim2.new(
				1,
				-105,
				0,
				0
			),

			TextXAlignment = Enum.TextXAlignment.Right,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = Header,
		})

	end

	local dropdownObj = {}
	
	local hasSlider = false

	local function SetValueDisplay(value)
		if SelectedLabel then
			SelectedLabel.Text = tostring(value)
			SelectedLabel.TextColor3 = Theme.SubText
		end
	end

	--=====================================================================
	-- SELECTED DROPDOWN ITEM
	--=====================================================================

	local selectedText = nil
	local selectedButton = nil

	local function SelectItem(itemText, itemButton)

		-- Remove highlight from previous selection
		if selectedButton and selectedButton ~= itemButton then

			selectedButton:SetAttribute("Selected", false)

			TweenService:Create(
				selectedButton,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = Theme.ElementBG
				}
			):Play()

			local oldLabel = selectedButton:FindFirstChildOfClass("TextLabel")

			if oldLabel then
				oldLabel.TextColor3 = Theme.Text
			end

		end

		selectedText = itemText
		selectedButton = itemButton

		-- Highlight new selection
		itemButton:SetAttribute("Selected", true)

		TweenService:Create(
			itemButton,
			TweenInfo.new(0.15),
			{
				BackgroundColor3 = Theme.Accent
			}
		):Play()

		local itemLabel = itemButton:FindFirstChildOfClass("TextLabel")

		if itemLabel then
			itemLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		end

		-- Show selected name
		if SelectedLabel then
			SelectedLabel.Text = itemText
			SelectedLabel.TextColor3 = Theme.SubText
		end

		dropdownObj.Selected = itemText
	end

	dropdownObj.GetSelected = function()
		return selectedText
	end
	
	dropdownObj.SetValueDisplay = SetValueDisplay

	dropdownObj.ClearSelection = function()

		if selectedButton then

			selectedButton:SetAttribute("Selected", false)

			TweenService:Create(
				selectedButton,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = Theme.ElementBG
				}
			):Play()

			local oldLabel = selectedButton:FindFirstChildOfClass("TextLabel")

			if oldLabel then
				oldLabel.TextColor3 = Theme.Text
			end

		end

		selectedButton = nil
		selectedText = nil

		if SelectedLabel then
			SelectedLabel.Text = ""
		end

		dropdownObj.Selected = nil
	end

	--=====================================================================
	-- MASTER TOGGLE
	--=====================================================================

	if isToggleType then

		local state = default == true

		local SwitchBG = Create("Frame", {
			Size = UDim2.new(0, 32, 0, 16),
			Position = UDim2.new(1, -40, 0.5, -8),
			BackgroundColor3 =
				state and Theme.Accent or Theme.SwitchOff,
			BorderSizePixel = 0,
			Parent = Header,
		}, {
			Create("UICorner", {
				CornerRadius = UDim.new(1, 0)
			}),
		})

		local Knob = Create("Frame", {
			Size = UDim2.new(0, 12, 0, 12),
			Position =
				state
				and UDim2.new(1, -14, 0.5, -6)
				or UDim2.new(0, 2, 0.5, -6),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BorderSizePixel = 0,
			Parent = SwitchBG,
		}, {
			Create("UICorner", {
				CornerRadius = UDim.new(1, 0)
			}),
		})

		local SwitchClick = Create("TextButton", {
			Size = UDim2.new(0, 32, 0, 16),
			Position = UDim2.new(1, -40, 0.5, -8),
			BackgroundTransparency = 1,
			Text = "",
			Parent = Header,
		})

		local function SetState(newState)

			state = newState

			TweenService:Create(
				SwitchBG,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 =
						state and Theme.Accent or Theme.SwitchOff
				}
			):Play()

			TweenService:Create(
				Knob,
				TweenInfo.new(0.15),
				{
					Position =
						state
						and UDim2.new(1, -14, 0.5, -6)
						or UDim2.new(0, 2, 0.5, -6)
				}
			):Play()

			if callback then
				callback(state)
			end
		end

		SwitchClick.MouseButton1Click:Connect(function()
			SetState(not state)
		end)

		dropdownObj.Toggle = {
			Set = SetState,

			Get = function()
				return state
			end,
		}
	end

	--=====================================================================
	-- INNER CONTENT
	--=====================================================================

	local Inner = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		Visible = false,
		LayoutOrder = 2,
		Parent = Container,
		ClipsDescendants = true,
	}, {
		Create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 4),
		}),

		Create("UIPadding", {
			PaddingLeft = UDim.new(0, 14),
			PaddingRight = UDim.new(0, 4),
			PaddingTop = UDim.new(0, 4),
			PaddingBottom = UDim.new(0, 6),
		}),
	})

	local InnerLayout = Inner:FindFirstChildOfClass("UIListLayout")
	local InnerPadding = Inner:FindFirstChildOfClass("UIPadding")

	--=====================================================================
	-- DROPDOWN ANIMATION
	--=====================================================================

	local dropdownTweenInfo = TweenInfo.new(
		0.25,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out
	)

	local function GetInnerHeight()

		if not InnerLayout then
			return 0
		end

		local contentHeight =
			InnerLayout.AbsoluteContentSize.Y

		if InnerPadding then
			contentHeight =
				contentHeight
				+ InnerPadding.PaddingTop.Offset
				+ InnerPadding.PaddingBottom.Offset
		end

		return contentHeight
	end

	local function UpdateInnerSize(animated)

		local targetHeight = GetInnerHeight()

		local targetSize =
			UDim2.new(
				1,
				0,
				0,
				targetHeight
			)

		if animated then

			TweenService:Create(
				Inner,
				dropdownTweenInfo,
				{
					Size = targetSize
				}
			):Play()

		else

			Inner.Size = targetSize

		end
	end

	--=====================================================================
	-- EXPAND / COLLAPSE
	--=====================================================================

	ExpandBtn.MouseEnter:Connect(function()

		TweenService:Create(
			ExpandBtn,
			TweenInfo.new(0.15),
			{
				BackgroundColor3 = Color3.fromRGB(58, 58, 64)
			}
		):Play()

	end)

	ExpandBtn.MouseLeave:Connect(function()

		TweenService:Create(
			ExpandBtn,
			TweenInfo.new(0.15),
			{
				BackgroundColor3 = Color3.fromRGB(46, 46, 51)
			}
		):Play()

	end)

	ExpandBtn.MouseButton1Click:Connect(function()

		expanded = not expanded

		if expanded then

			-- Show before calculating its content size
			Inner.Visible = true

			Inner.Size = UDim2.new(
				1,
				0,
				0,
				0
			)

			UpdateInnerSize(true)

			ExpandBtn.Text = "−"

			-- Small button animation
			TweenService:Create(
				ExpandBtn,
				TweenInfo.new(
					0.15,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				),
				{
					Size = UDim2.new(0, 19, 0, 19),
					Position = UDim2.new(0, 4.5, 0.5, -9.5)
				}
			):Play()

		else

			local closeTween = TweenService:Create(
				Inner,
				dropdownTweenInfo,
				{
					Size = UDim2.new(
						1,
						0,
						0,
						0
					)
				}
			)

			closeTween:Play()

			closeTween.Completed:Connect(function()

				if not expanded then
					Inner.Visible = false
				end

			end)

			ExpandBtn.Text = "+"

			TweenService:Create(
				ExpandBtn,
				TweenInfo.new(
					0.15,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				),
				{
					Size = UDim2.new(0, 18, 0, 18),
					Position = UDim2.new(0, 5, 0.5, -9)
				}
			):Play()

		end
	end)

	--=====================================================================
	-- UPDATE WHEN NESTED CONTENT CHANGES SIZE
	--=====================================================================

	if InnerLayout then

		InnerLayout:GetPropertyChangedSignal(
			"AbsoluteContentSize"
		):Connect(function()

			if expanded then
				UpdateInnerSize(false)
			end

		end)

	end

	--=========================================================================
	-- ATTACH ELEMENT CREATION METHODS TO DROPDOWN
	--=========================================================================

	dropdownObj.Instance = Container
	dropdownObj.Inner = Inner

	AttachElementFunctions(
		dropdownObj,
		Inner,
		SelectItem,
		defaultSelection,
		SelectItem
	)

	return dropdownObj

end

--=========================================================================
-- ATTACH ELEMENT CREATION METHODS
--=========================================================================
AttachElementFunctions = function(
	obj,
	parentFrame,
	onDropdownSelected,
	defaultSelection,
	SelectItem
)

	function obj:CreateToggle(text, default, callback)

		return CreateToggleElement(
			parentFrame,
			text,
			default,
			callback
		)

	end

	function obj:CreateButton(text, callback)

		local button = CreateButtonElement(
			parentFrame,
			text,
			callback,
			onDropdownSelected
		)

		-- Automatically select default
		if defaultSelection ~= nil and text == defaultSelection then
			onDropdownSelected(text, button.Instance)
		end

		return button
	end

	function obj:CreateSlider(text, minValue, maxValue, defaultValue, callback)

		local sliderCallback = callback

		if onDropdownSelected then

			sliderCallback = function(value)

				-- Show value in dropdown header
				if obj.SetValueDisplay then
					obj.SetValueDisplay(value)
				end

				-- Run original callback
				if callback then
					callback(value)
				end

			end

		end

		local slider = CreateSliderElement(
			parentFrame,
			text,
			minValue,
			maxValue,
			defaultValue,
			sliderCallback
		)

		-- Show default value immediately
		if onDropdownSelected and obj.SetValueDisplay then
			obj.SetValueDisplay(slider.Get())
		end

		return slider

	end

	function obj:CreateDropdown(text, defaultSelection)

		return CreateDropdownElement(
			parentFrame,
			text,
			false,
			nil,
			nil,
			defaultSelection
		)

	end

	function obj:CreateToggleDropdown(
		text,
		default,
		callback,
		defaultSelection
	)

		return CreateDropdownElement(
			parentFrame,
			text,
			true,
			default,
			callback,
			defaultSelection
		)

	end
end

