CreateDropdownElement = function(
    parentFrame,
    text,
    isToggleType,
    default,
    callback
)

    local expanded = false

    local Container = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.ElementBG,
        BackgroundTransparency = UISettings.Transparency,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = parentFrame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4)
        }),

        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 0),
        }),
    })

    --=====================================================================
    -- HEADER
    --=====================================================================

    local Header = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        LayoutOrder = 1,
        Parent = Container,
    })

    --=====================================================================
    -- EXPAND BUTTON
    --=====================================================================

    local ExpandBtn = Create("TextButton", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0, 5, 0.5, -9),
        BackgroundColor3 = Theme.Stroke,
        AutoButtonColor = false,
        Text = "+",
        Font = Theme.FontBold,
        TextSize = 14,
        TextColor3 = Theme.Text,
        Parent = Header,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4)
        }),
    })

    --=====================================================================
    -- TITLE
    --=====================================================================

    local titleRightPad =
        isToggleType and 90 or 40

    local Title = Create("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(
            1,
            -(28 + titleRightPad),
            1,
            0
        ),
        Position = UDim2.new(0, 28, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Header,
    })

    local dropdownObj = {}

    --=====================================================================
    -- TOGGLE DROPDOWN SWITCH
    --=====================================================================

    if isToggleType then

        local state = default == true

        local SwitchBG = Create("Frame", {
            Size = UDim2.new(0, 32, 0, 16),
            Position = UDim2.new(1, -40, 0.5, -8),
            BackgroundColor3 =
                state and Theme.Accent or Theme.SwitchOff,
            BackgroundTransparency =
                UISettings.Transparency,
            BorderSizePixel = 0,
            Parent = Header,
        }, {
            Create("UICorner", {
                CornerRadius = UDim.new(1, 0)
            }),
        })

        local Knob = Create("Frame", {
            Size = UDim2.new(0, 12, 0, 12),
            Position =
                state
                and UDim2.new(1, -14, 0.5, -6)
                or UDim2.new(0, 2, 0.5, -6),
            BackgroundColor3 =
                Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0,
            Parent = SwitchBG,
        }, {
            Create("UICorner", {
                CornerRadius = UDim.new(1, 0)
            }),
        })

        local SwitchClick = Create("TextButton", {
            Size = UDim2.new(0, 32, 0, 16),
            Position = UDim2.new(1, -40, 0.5, -8),
            BackgroundTransparency = 1,
            Text = "",
            Parent = Header,
        })

        local function SetState(newState)

            state = newState

            TweenService:Create(
                SwitchBG,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 =
                        state and Theme.Accent
                        or Theme.SwitchOff
                }
            ):Play()

            TweenService:Create(
                Knob,
                TweenInfo.new(0.15),
                {
                    Position =
                        state
                        and UDim2.new(1, -14, 0.5, -6)
                        or UDim2.new(0, 2, 0.5, -6)
                }
            ):Play()

            if callback then
                callback(state)
            end
        end

        SwitchClick.MouseButton1Click:Connect(function()
            SetState(not state)
        end)

        dropdownObj.Toggle = {
            Set = SetState,

            Get = function()
                return state
            end,
        }

        dropdownObj._ToggleTheme = function()

            SwitchBG.BackgroundColor3 =
                state and Theme.Accent
                or Theme.SwitchOff

            SwitchBG.BackgroundTransparency =
                UISettings.Transparency

        end
    end

    --=====================================================================
    -- INNER CONTENT
    --=====================================================================

    local Inner = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        Visible = false,
        LayoutOrder = 2,
        ClipsDescendants = true,
        Parent = Container,
    }, {
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 4),
        }),

        Create("UIPadding", {
            PaddingLeft = UDim.new(0, 14),
            PaddingRight = UDim.new(0, 4),
            PaddingTop = UDim.new(0, 4),
            PaddingBottom = UDim.new(0, 6),
        }),
    })

    local InnerLayout =
        Inner:FindFirstChildOfClass("UIListLayout")

    local InnerPadding =
        Inner:FindFirstChildOfClass("UIPadding")

    --=====================================================================
    -- DROPDOWN ANIMATION
    --=====================================================================

    local dropdownTweenInfo = TweenInfo.new(
        0.25,
        Enum.EasingStyle.Quart,
        Enum.EasingDirection.Out
    )

    local function GetInnerHeight()

        if not InnerLayout then
            return 0
        end

        local height =
            InnerLayout.AbsoluteContentSize.Y

        if InnerPadding then

            height =
                height
                + InnerPadding.PaddingTop.Offset
                + InnerPadding.PaddingBottom.Offset

        end

        return height
    end

    local function UpdateInnerSize(animated)

        local targetHeight =
            GetInnerHeight()

        local targetSize =
            UDim2.new(
                1,
                0,
                0,
                targetHeight
            )

        if animated then

            TweenService:Create(
                Inner,
                dropdownTweenInfo,
                {
                    Size = targetSize
                }
            ):Play()

        else

            Inner.Size = targetSize

        end
    end

    --=====================================================================
    -- EXPAND / COLLAPSE
    --=====================================================================

    ExpandBtn.MouseEnter:Connect(function()

        TweenService:Create(
            ExpandBtn,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Theme.Secondary
            }
        ):Play()

    end)

    ExpandBtn.MouseLeave:Connect(function()

        TweenService:Create(
            ExpandBtn,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Theme.Stroke
            }
        ):Play()

    end)

    ExpandBtn.MouseButton1Click:Connect(function()

        expanded = not expanded

        if expanded then

            Inner.Visible = true

            Inner.Size =
                UDim2.new(1, 0, 0, 0)

            UpdateInnerSize(true)

            ExpandBtn.Text = "−"

        else

            local closeTween =
                TweenService:Create(
                    Inner,
                    dropdownTweenInfo,
                    {
                        Size =
                            UDim2.new(
                                1,
                                0,
                                0,
                                0
                            )
                    }
                )

            closeTween:Play()

            closeTween.Completed:Connect(function()

                if not expanded then
                    Inner.Visible = false
                end

            end)

            ExpandBtn.Text = "+"

        end
    end)

    --=====================================================================
    -- NESTED DROPDOWN RESIZING
    --=====================================================================

    if InnerLayout then

        InnerLayout:GetPropertyChangedSignal(
            "AbsoluteContentSize"
        ):Connect(function()

            if expanded then
                UpdateInnerSize(false)
            end

        end)

    end

    --=====================================================================
    -- RETURN
    --=====================================================================

    dropdownObj.Instance = Container
    dropdownObj.Inner = Inner

    dropdownObj._Theme = function()

        Container.BackgroundColor3 =
            Theme.ElementBG

        Container.BackgroundTransparency =
            UISettings.Transparency

        ExpandBtn.BackgroundColor3 =
            Theme.Stroke

        ExpandBtn.TextColor3 =
            Theme.Text

        Title.TextColor3 =
            Theme.Text

        if dropdownObj._ToggleTheme then
            dropdownObj._ToggleTheme()
        end

    end

    AttachElementFunctions(
        dropdownObj,
        Inner
    )

    return dropdownObj
end

--=========================================================================
-- ATTACH ELEMENT FUNCTIONS
--=========================================================================
AttachElementFunctions = function(obj, parentFrame)

    function obj:CreateToggle(text, default, callback)

        return CreateToggleElement(
            parentFrame,
            text,
            default,
            callback
        )

    end

    function obj:CreateButton(text, callback)

        return CreateButtonElement(
            parentFrame,
            text,
            callback
        )

    end

    function obj:CreateSlider(
        text,
        min,
        max,
        default,
        callback
    )

        return CreateSliderElement(
            parentFrame,
            text,
            min,
            max,
            default,
            callback
        )

    end

    function obj:CreateDropdown(text)

        return CreateDropdownElement(
            parentFrame,
            text,
            false,
            nil,
            nil
        )

    end

    function obj:CreateToggleDropdown(
        text,
        default,
        callback
    )

        return CreateDropdownElement(
            parentFrame,
            text,
            true,
            default,
            callback
        )

    end
end

