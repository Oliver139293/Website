                }, bdy)

                local isOpen = openValue == true

                local function update()
                    local height = 38
                    if isOpen then
                        height = 38 + bdy.AbsoluteSize.Y + 8
                    end

                    tween(d, 0.18, {
                        Size = UDim2.new(1, 0, 0, height)
                    })

                    s.Text = isOpen and "−" or "+"
                end

                bdy:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                    if isOpen then update() end
                end)

                h.MouseButton1Click:Connect(function()
                    isOpen = not isOpen
                    update()
                end)

                local result = {}

                function result:CreateButton(labelText, callback)
                    local b = new("TextButton", {
                        Size = UDim2.new(1, 0, 0, 34),
                        BackgroundColor3 = COLORS.Background,
                        BorderSizePixel = 0,
                        Text = labelText or "Button",
                        TextColor3 = COLORS.Text,
                        TextSize = 10,
                        Font = Enum.Font.GothamMedium,
                        AutoButtonColor = false,
                        LayoutOrder = #bdy:GetChildren()
                    }, bdy)
                    corner(b, 5)
                    b.MouseButton1Click:Connect(function()
                        if callback then callback() end
                    end)
                    return b
                end

                function result:CreateToggle(labelText, defaultValue, callback)
                    local value = defaultValue == true

                    local b = new("TextButton", {
                        Size = UDim2.new(1, 0, 0, 34),
                        BackgroundColor3 = COLORS.Background,
                        BorderSizePixel = 0,
                        Text = "",
                        AutoButtonColor = false,
                        LayoutOrder = #bdy:GetChildren()
                    }, bdy)
                    corner(b, 5)

                    local label = new("TextLabel", {
                        Size = UDim2.new(1, -55, 1, 0),
                        Position = UDim2.fromOffset(9, 0),
                        BackgroundTransparency = 1,
                        Text = labelText or "Toggle",
                        TextColor3 = COLORS.Text,
                        TextSize = 10,
                        Font = Enum.Font.GothamMedium,
                        TextXAlignment = Enum.TextXAlignment.Left
                    }, b)

                    local function update()
                        label.Text = (value and "●  " or "○  ") .. (labelText or "Toggle")
                    end

                    update()

                    b.MouseButton1Click:Connect(function()
                        value = not value
                        update()
                        if callback then callback(value) end
                    end)

                    return {
                        Get = function()
                            return value
                        end,
                        Set = function(_, v)
                            value = v == true
                            update()
                            if callback then callback(value) end
                        end
                    }
                end

                return result
            end

            return nested
        end

        function api:CreateSeparator()
            return new("Frame", {
                Size = UDim2.new(1, 0, 0, 1),
                BackgroundColor3 = COLORS.Border,
                BorderSizePixel = 0,
                LayoutOrder = #body:GetChildren()
            }, body)
        end

        table.insert(tab.Items, container)
        refresh()

        return api
    end

    button.MouseButton1Click:Connect(function()
        if self.ActiveTab then
            self.ActiveTab:SetActive(false)
        end

        self.ActiveTab = tab
        tab:SetActive(true)
    end)

    table.insert(self.Tabs, tab)

    if not self.ActiveTab then
        self.ActiveTab = tab
        tab:SetActive(true)
    end

    return tab
end

function Library:Destroy()
    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end
end

return Library
