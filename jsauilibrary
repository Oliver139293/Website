            CornerRadius = UDim.new(0, 4)
        }),
    })

    local Label = Create("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -10, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    Holder.MouseEnter:Connect(function()

        Tween(
            Holder,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 =
                    Theme.Stroke
            }
        )

    end)

    Holder.MouseLeave:Connect(function()

        Tween(
            Holder,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 =
                    Theme.ElementBG
            }
        )

    end)

    Holder.MouseButton1Click:Connect(function()

        if callback then
            callback()
        end

        Tween(
            Holder,
            TweenInfo.new(0.1),
            {
                BackgroundColor3 =
                    Theme.Accent
            }
        )

        task.delay(0.1, function()

            if Holder.Parent then

                Tween(
                    Holder,
                    TweenInfo.new(0.15),
                    {
                        BackgroundColor3 =
                            Theme.ElementBG
                    }
                )

            end

        end)

    end)

    return {

        Instance = Holder,

        _Theme = function(themeTween)

            Tween(
                Holder,
                themeTween,
                {
                    BackgroundColor3 =
                        Theme.ElementBG,

                    BackgroundTransparency =
                        UISettings.Transparency
                }
            )

            Tween(
                Label,
                themeTween,
                {
                    TextColor3 =
                        Theme.Text
                }
            )

        end,

    }

end

