CreateToggleElement = function(parentFrame, text, default, callback)

    local state = default == true

    local Holder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = Theme.ElementBG,
        BackgroundTransparency = UISettings.Transparency,
        BorderSizePixel = 0,
        Parent = parentFrame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4)
        }),
    })

    local Label = Create("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -46, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    local SwitchBG = Create("Frame", {
        Size = UDim2.new(0, 32, 0, 16),
        Position = UDim2.new(1, -40, 0.5, -8),
        BackgroundColor3 =
            state and Theme.Accent or Theme.SwitchOff,
        BackgroundTransparency = UISettings.Transparency,
        BorderSizePixel = 0,
        Parent = Holder,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0)
        }),
    })

    local Knob = Create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position =
            state
            and UDim2.new(1, -14, 0.5, -6)
            or UDim2.new(0, 2, 0.5, -6),
        BackgroundColor3 =
            Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = SwitchBG,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0)
        }),
    })

    local Click = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = Holder,
    })

    local function SetState(newState)

        state = newState

        Tween(
            SwitchBG,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 =
                    state
                    and Theme.Accent
                    or Theme.SwitchOff
            }
        )

        Tween(
            Knob,
            TweenInfo.new(0.15),
            {
                Position =
                    state
                    and UDim2.new(1, -14, 0.5, -6)
                    or UDim2.new(0, 2, 0.5, -6)
            }
        )

        if callback then
            callback(state)
        end

    end

    Click.MouseButton1Click:Connect(function()
        SetState(not state)
    end)

    return {

        Instance = Holder,

        Set = SetState,

        Get = function()
            return state
        end,

        _Theme = function(themeTween)

            Tween(
                Holder,
                themeTween,
                {
                    BackgroundColor3 =
                        Theme.ElementBG,

                    BackgroundTransparency =
                        UISettings.Transparency
                }
            )

            Tween(
                Label,
                themeTween,
                {
                    TextColor3 =
                        Theme.Text
                }
            )

            Tween(
                SwitchBG,
                themeTween,
                {
                    BackgroundColor3 =
                        state
                        and Theme.Accent
                        or Theme.SwitchOff,

                    BackgroundTransparency =
                        UISettings.Transparency
                }
            )

        end,
    }

end

