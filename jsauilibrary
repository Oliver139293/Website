        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = Theme.ElementBG,
        BackgroundTransparency = UISettings.Transparency,
        AutoButtonColor = false,
        Text = "",
        BorderSizePixel = 0,
        Parent = parentFrame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4)
        }),
    })

    local Label = Create("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -10, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    Holder.MouseEnter:Connect(function()

        TweenService:Create(
            Holder,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Theme.Stroke
            }
        ):Play()

    end)

    Holder.MouseLeave:Connect(function()

        TweenService:Create(
            Holder,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Theme.ElementBG
            }
        ):Play()

    end)

    Holder.MouseButton1Click:Connect(function()

        if callback then
            callback()
        end

        local flash = TweenService:Create(
            Holder,
            TweenInfo.new(0.1),
            {
                BackgroundColor3 = Theme.Accent
            }
        )

        flash:Play()

        flash.Completed:Connect(function()

            TweenService:Create(
                Holder,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 = Theme.ElementBG
                }
            ):Play()

        end)
    end)

    return {
        Instance = Holder,

        _Theme = function()

            Holder.BackgroundColor3 = Theme.ElementBG
            Holder.BackgroundTransparency = UISettings.Transparency
            Label.TextColor3 = Theme.Text

        end,
    }
end

--=========================================================================
-- CREATE SLIDER
--=========================================================================
CreateSliderElement = function(
    parentFrame,
    text,
    min,
    max,
    default,
    callback
)

    local value = math.clamp(
        default or min,
        min,
        max
    )

    local Holder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = Theme.ElementBG,
        BackgroundTransparency = UISettings.Transparency,
        BorderSizePixel = 0,
        Parent = parentFrame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4)
        }),
    })

    local Label = Create("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -60, 0, 20),
        Position = UDim2.new(0, 10, 0, 3),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    local ValueLabel = Create("TextLabel", {
        Text = tostring(value),
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.SubText,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 45, 0, 20),
        Position = UDim2.new(1, -52, 0, 3),
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = Holder,
    })

    local SliderBackground = Create("Frame", {
        Size = UDim2.new(1, -20, 0, 5),
        Position = UDim2.new(0, 10, 0, 31),
        BackgroundColor3 = Theme.SwitchOff,
        BorderSizePixel = 0,
        Parent = Holder,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0)
        }),
    })

    local SliderFill = Create("Frame", {
        Size = UDim2.new(
            (value - min) / (max - min),
            0,
            1,
            0
        ),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = SliderBackground,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0)
        }),
    })

    local SliderKnob = Create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(
            (value - min) / (max - min),
            0,
            0.5,
            0
        ),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = SliderBackground,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0)
        }),
    })

    local SliderButton = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = SliderBackground,
    })

    local dragging = false

    local function SetValue(newValue)

        value = math.clamp(
            newValue,
            min,
            max
        )

        value = math.floor(value * 100) / 100

        local percent =
            (value - min) / (max - min)

        SliderFill.Size =
            UDim2.new(percent, 0, 1, 0)

        SliderKnob.Position =
            UDim2.new(percent, 0, 0.5, 0)

        ValueLabel.Text =
            tostring(value)

        if callback then
            callback(value)
        end
    end

    local function UpdateFromMouse(x)

        local startX = SliderBackground.AbsolutePosition.X
        local width = SliderBackground.AbsoluteSize.X

        local percent =
            math.clamp(
                (x - startX) / width,
                0,
                1
            )

        local newValue =
            min + ((max - min) * percent)

        SetValue(newValue)
    end

    SliderButton.InputBegan:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            UpdateFromMouse(input.Position.X)

        end

    end)

    UserInputService.InputChanged:Connect(function(input)

        if dragging then

            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then

                UpdateFromMouse(input.Position.X)

            end

        end

    end)

    UserInputService.InputEnded:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = false

        end

    end)

    return {
        Instance = Holder,
        Set = SetValue,

        Get = function()
            return value
        end,

        _Theme = function()

            Holder.BackgroundColor3 = Theme.ElementBG
            Holder.BackgroundTransparency =
                UISettings.Transparency

            Label.TextColor3 = Theme.Text
            ValueLabel.TextColor3 = Theme.SubText

            SliderBackground.BackgroundColor3 =
                Theme.SwitchOff

            SliderFill.BackgroundColor3 =
                Theme.Accent

        end,
    }
end

