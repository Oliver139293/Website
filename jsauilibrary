--=========================================================================
-- TOGGLE ELEMENT
--=========================================================================
CreateToggleElement = function(parentFrame, text, default, callback)

    local state = default == true

    local Holder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,
        Parent = parentFrame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4)
        }),
    })

    Create("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -46, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    local SwitchBG = Create("Frame", {
        Size = UDim2.new(0, 32, 0, 16),
        Position = UDim2.new(1, -40, 0.5, -8),
        BackgroundColor3 = state and Theme.Accent or Theme.SwitchOff,
        BorderSizePixel = 0,
        Parent = Holder,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0)
        }),
    })

    local Knob = Create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = state
            and UDim2.new(1, -14, 0.5, -6)
            or UDim2.new(0, 2, 0.5, -6),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = SwitchBG,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0)
        }),
    })

    local Click = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = Holder,
    })

    local function SetState(newState)

        state = newState

        TweenService:Create(
            SwitchBG,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 =
                    state and Theme.Accent or Theme.SwitchOff
            }
        ):Play()

        TweenService:Create(
            Knob,
            TweenInfo.new(0.15),
            {
                Position =
                    state
                    and UDim2.new(1, -14, 0.5, -6)
                    or UDim2.new(0, 2, 0.5, -6)
            }
        ):Play()

        if callback then
            callback(state)
        end
    end

    Click.MouseButton1Click:Connect(function()
        SetState(not state)
    end)

    return {
        Instance = Holder,
        Set = SetState,
        Get = function()
            return state
        end,
    }
end

--=========================================================================
-- BUTTON ELEMENT
--=========================================================================
CreateButtonElement = function(parentFrame, text, callback)

    local Holder = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = Theme.ElementBG,
        AutoButtonColor = false,
        Text = "",
        BorderSizePixel = 0,
        Parent = parentFrame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4)
        }),
    })

    Create("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -10, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    Holder.MouseEnter:Connect(function()
        TweenService:Create(
            Holder,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            }
        ):Play()
    end)

    Holder.MouseLeave:Connect(function()
        TweenService:Create(
            Holder,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Theme.ElementBG
            }
        ):Play()
    end)

    Holder.MouseButton1Click:Connect(function()

        if callback then
            callback()
        end

        local flashIn = TweenService:Create(
            Holder,
            TweenInfo.new(0.1),
            {
                BackgroundColor3 = Theme.Accent
            }
        )

        flashIn:Play()

        flashIn.Completed:Connect(function()

            TweenService:Create(
                Holder,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 = Theme.ElementBG
                }
            ):Play()

        end)
    end)

    return {
        Instance = Holder
    }
end

--=========================================================================
-- DROPDOWN ELEMENT
--=========================================================================
CreateDropdownElement = function(
    parentFrame,
    text,
    isToggleType,
    default,
    callback
)

    local expanded = false

    local Container = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,
        Parent = parentFrame,
        ClipsDescendants = true,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4)
        }),

        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 0),
        }),
    })

    --=====================================================================
    -- HEADER
    --=====================================================================

    local Header = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        LayoutOrder = 1,
        Parent = Container,
    })

    --=====================================================================
    -- EXPAND BUTTON
    --=====================================================================

    local ExpandBtn = Create("TextButton", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0, 5, 0.5, -9),
        BackgroundColor3 = Color3.fromRGB(46, 46, 51),
        AutoButtonColor = false,
        Text = "+",
        Font = Theme.FontBold,
        TextSize = 14,
        TextColor3 = Theme.Text,
        Parent = Header,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4)
        }),
    })

    --=====================================================================
    -- TITLE
    --=====================================================================

    local titleRightPad = isToggleType and 90 or 40

    Create("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(
            1,
            -(28 + titleRightPad),
            1,
            0
        ),
        Position = UDim2.new(0, 28, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Header,
    })

    local dropdownObj = {}

    --=====================================================================
    -- MASTER TOGGLE
    --=====================================================================

    if isToggleType then

        local state = default == true

        local SwitchBG = Create("Frame", {
            Size = UDim2.new(0, 32, 0, 16),
            Position = UDim2.new(1, -40, 0.5, -8),
            BackgroundColor3 =
                state and Theme.Accent or Theme.SwitchOff,
            BorderSizePixel = 0,
            Parent = Header,
        }, {
            Create("UICorner", {
                CornerRadius = UDim.new(1, 0)
            }),
        })

        local Knob = Create("Frame", {
            Size = UDim2.new(0, 12, 0, 12),
            Position =
                state
                and UDim2.new(1, -14, 0.5, -6)
                or UDim2.new(0, 2, 0.5, -6),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0,
            Parent = SwitchBG,
        }, {
            Create("UICorner", {
                CornerRadius = UDim.new(1, 0)
            }),
        })

        local SwitchClick = Create("TextButton", {
            Size = UDim2.new(0, 32, 0, 16),
            Position = UDim2.new(1, -40, 0.5, -8),
            BackgroundTransparency = 1,
            Text = "",
            Parent = Header,
        })

        local function SetState(newState)

            state = newState

            TweenService:Create(
                SwitchBG,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 =
                        state and Theme.Accent or Theme.SwitchOff
                }
            ):Play()

            TweenService:Create(
                Knob,
                TweenInfo.new(0.15),
                {
                    Position =
                        state
                        and UDim2.new(1, -14, 0.5, -6)
                        or UDim2.new(0, 2, 0.5, -6)
                }
            ):Play()

            if callback then
                callback(state)
            end
        end

        SwitchClick.MouseButton1Click:Connect(function()
            SetState(not state)
        end)

        dropdownObj.Toggle = {
            Set = SetState,

            Get = function()
                return state
            end,
        }
    end

    --=====================================================================
    -- INNER CONTENT
    --=====================================================================

    local Inner = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        Visible = false,
        LayoutOrder = 2,
        Parent = Container,
        ClipsDescendants = true,
    }, {
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 4),
        }),

        Create("UIPadding", {
            PaddingLeft = UDim.new(0, 14),
            PaddingRight = UDim.new(0, 4),
            PaddingTop = UDim.new(0, 4),
            PaddingBottom = UDim.new(0, 6),
        }),
    })

    local InnerLayout = Inner:FindFirstChildOfClass("UIListLayout")
    local InnerPadding = Inner:FindFirstChildOfClass("UIPadding")

    --=====================================================================
    -- DROPDOWN ANIMATION
    --=====================================================================

    local dropdownTweenInfo = TweenInfo.new(
        0.25,
        Enum.EasingStyle.Quart,
        Enum.EasingDirection.Out
    )

    local function GetInnerHeight()

        if not InnerLayout then
            return 0
        end

        local contentHeight =
            InnerLayout.AbsoluteContentSize.Y

        if InnerPadding then
            contentHeight =
                contentHeight
                + InnerPadding.PaddingTop.Offset
                + InnerPadding.PaddingBottom.Offset
        end

        return contentHeight
    end

    local function UpdateInnerSize(animated)

        local targetHeight = GetInnerHeight()

        local targetSize =
            UDim2.new(
                1,
                0,
                0,
                targetHeight
            )

        if animated then

            TweenService:Create(
                Inner,
                dropdownTweenInfo,
                {
                    Size = targetSize
                }
            ):Play()

        else

            Inner.Size = targetSize

        end
    end

    --=====================================================================
    -- EXPAND / COLLAPSE
    --=====================================================================

    ExpandBtn.MouseEnter:Connect(function()

        TweenService:Create(
            ExpandBtn,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Color3.fromRGB(58, 58, 64)
            }
        ):Play()

    end)

    ExpandBtn.MouseLeave:Connect(function()

        TweenService:Create(
            ExpandBtn,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Color3.fromRGB(46, 46, 51)
            }
        ):Play()

    end)

    ExpandBtn.MouseButton1Click:Connect(function()

        expanded = not expanded

        if expanded then

            -- Show before calculating its content size
            Inner.Visible = true

            Inner.Size = UDim2.new(
                1,
                0,
                0,
                0
            )

            UpdateInnerSize(true)

            ExpandBtn.Text = "−"

            -- Small button animation
            TweenService:Create(
                ExpandBtn,
                TweenInfo.new(
                    0.15,
                    Enum.EasingStyle.Back,
                    Enum.EasingDirection.Out
                ),
                {
                    Size = UDim2.new(0, 19, 0, 19),
                    Position = UDim2.new(0, 4.5, 0.5, -9.5)
                }
            ):Play()

        else

            local closeTween = TweenService:Create(
                Inner,
                dropdownTweenInfo,
                {
                    Size = UDim2.new(
                        1,
                        0,
                        0,
                        0
                    )
                }
            )

            closeTween:Play()

            closeTween.Completed:Connect(function()

                if not expanded then
                    Inner.Visible = false
                end

            end)

            ExpandBtn.Text = "+"

            TweenService:Create(
                ExpandBtn,
                TweenInfo.new(
                    0.15,
                    Enum.EasingStyle.Back,
                    Enum.EasingDirection.Out
                ),
                {
                    Size = UDim2.new(0, 18, 0, 18),
                    Position = UDim2.new(0, 5, 0.5, -9)
                }
            ):Play()

        end
    end)

    --=====================================================================
    -- UPDATE WHEN NESTED CONTENT CHANGES SIZE
    --=====================================================================

    if InnerLayout then

        InnerLayout:GetPropertyChangedSignal(
            "AbsoluteContentSize"
        ):Connect(function()

            if expanded then
                UpdateInnerSize(false)
            end

        end)

    end

    --=====================================================================
    -- RETURN DROPDOWN
    --=====================================================================

    dropdownObj.Instance = Container
    dropdownObj.Inner = Inner

    AttachElementFunctions(
        dropdownObj,
        Inner
    )

    return dropdownObj
end

--=========================================================================
-- ATTACH ELEMENT CREATION METHODS
--=========================================================================
AttachElementFunctions = function(obj, parentFrame)

    function obj:CreateToggle(text, default, callback)

        return CreateToggleElement(
            parentFrame,
            text,
            default,
            callback
        )

    end

    function obj:CreateButton(text, callback)

        return CreateButtonElement(
            parentFrame,
            text,
            callback
        )

    end

    function obj:CreateDropdown(text)

        return CreateDropdownElement(
            parentFrame,
            text,
            false,
            nil,
            nil
        )

    end

    function obj:CreateToggleDropdown(
        text,
        default,
        callback
    )

        return CreateDropdownElement(
            parentFrame,
            text,
            true,
            default,
            callback
        )

    end
end

