local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

--=========================================================================
-- THEME
--=========================================================================
local Theme = {
    Background   = Color3.fromRGB(24, 24, 27),
    Secondary    = Color3.fromRGB(32, 32, 36),
    ElementBG    = Color3.fromRGB(38, 38, 43),
    Stroke       = Color3.fromRGB(50, 50, 55),
    Accent       = Color3.fromRGB(85, 145, 235),
    Text         = Color3.fromRGB(235, 235, 235),
    SubText      = Color3.fromRGB(160, 160, 165),
    SwitchOff    = Color3.fromRGB(60, 60, 65),
    Font         = Enum.Font.Gotham,
    FontBold     = Enum.Font.GothamBold,
}

--=========================================================================
-- HELPERS
--=========================================================================
local function Create(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    for _, c in ipairs(children or {}) do
        c.Parent = inst
    end
    return inst
end

local function MakeDraggable(dragHandle, frame)
    local dragging = false
    local dragInput
    local dragStart
    local startPos

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

--=========================================================================
-- FORWARD DECLARATIONS (mutual recursion for nested dropdowns)
--=========================================================================
local AttachElementFunctions
local CreateToggleElement
local CreateButtonElement
local CreateDropdownElement

--=========================================================================
-- TOGGLE ELEMENT
--=========================================================================
CreateToggleElement = function(parentFrame, text, default, callback)
    local state = default == true

    local Holder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,
        Parent = parentFrame,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
    })

    Create("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -46, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    local SwitchBG = Create("Frame", {
        Size = UDim2.new(0, 32, 0, 16),
        Position = UDim2.new(1, -40, 0.5, -8),
        BackgroundColor3 = state and Theme.Accent or Theme.SwitchOff,
        BorderSizePixel = 0,
        Parent = Holder,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local Knob = Create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = SwitchBG,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local Click = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = Holder,
    })

    local function SetState(newState)
        state = newState
        TweenService:Create(SwitchBG, TweenInfo.new(0.15), {
            BackgroundColor3 = state and Theme.Accent or Theme.SwitchOff,
        }):Play()
        TweenService:Create(Knob, TweenInfo.new(0.15), {
            Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6),
        }):Play()
        if callback then
            callback(state)
        end
    end

    Click.MouseButton1Click:Connect(function()
        SetState(not state)
    end)

    return {
        Instance = Holder,
        Set = SetState,
        Get = function() return state end,
    }
end

--=========================================================================
-- BUTTON ELEMENT
--=========================================================================
CreateButtonElement = function(parentFrame, text, callback)
    local Holder = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = Theme.ElementBG,
        AutoButtonColor = false,
        Text = "",
        BorderSizePixel = 0,
        Parent = parentFrame,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
    })

    Create("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -10, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Holder,
    })

    Holder.MouseButton1Click:Connect(function()
        if callback then
            callback()
        end
        local flashIn = TweenService:Create(Holder, TweenInfo.new(0.1), { BackgroundColor3 = Theme.Accent })
        flashIn:Play()
        flashIn.Completed:Connect(function()
            TweenService:Create(Holder, TweenInfo.new(0.15), { BackgroundColor3 = Theme.ElementBG }):Play()
        end)
    end)

    return { Instance = Holder }
end

--=========================================================================
-- DROPDOWN ELEMENT (Normal + Toggle variants, fully nestable)
--=========================================================================
CreateDropdownElement = function(parentFrame, text, isToggleType, default, callback)
    local expanded = false

    local Container = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,
        Parent = parentFrame,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 0),
        }),
    })

    local Header = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        LayoutOrder = 1,
        Parent = Container,
    })

    -- Expand / Collapse button ( + / - )
    local ExpandBtn = Create("TextButton", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0, 5, 0.5, -9),
        BackgroundColor3 = Color3.fromRGB(46, 46, 51),
        AutoButtonColor = false,
        Text = "+",
        Font = Theme.FontBold,
        TextSize = 14,
        TextColor3 = Theme.Text,
        Parent = Header,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
    })

    -- Reserve space on the right for the toggle switch if this is a Toggle Dropdown
    local titleRightPad = isToggleType and 90 or 40

    Create("TextLabel", {
        Text = text,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -(28 + titleRightPad), 1, 0),
        Position = UDim2.new(0, 28, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Header,
    })

    local dropdownObj = {}

    -- Master [Toggle] switch, only for Toggle Dropdown type
    if isToggleType then
        local state = default == true

        local SwitchBG = Create("Frame", {
            Size = UDim2.new(0, 32, 0, 16),
            Position = UDim2.new(1, -40, 0.5, -8),
            BackgroundColor3 = state and Theme.Accent or Theme.SwitchOff,
            BorderSizePixel = 0,
            Parent = Header,
        }, {
            Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
        })

        local Knob = Create("Frame", {
            Size = UDim2.new(0, 12, 0, 12),
            Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0,
            Parent = SwitchBG,
        }, {
            Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
        })

        local SwitchClick = Create("TextButton", {
            Size = UDim2.new(0, 32, 0, 16),
            Position = UDim2.new(1, -40, 0.5, -8),
            BackgroundTransparency = 1,
            Text = "",
            Parent = Header,
        })

        local function SetState(newState)
            state = newState
            TweenService:Create(SwitchBG, TweenInfo.new(0.15), {
                BackgroundColor3 = state and Theme.Accent or Theme.SwitchOff,
            }):Play()
            TweenService:Create(Knob, TweenInfo.new(0.15), {
                Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6),
            }):Play()
            if callback then
                callback(state)
            end
        end

        SwitchClick.MouseButton1Click:Connect(function()
            SetState(not state)
        end)

        dropdownObj.Toggle = {
            Set = SetState,
            Get = function() return state end,
        }
    end

    -- Inner content (indented, holds nested elements; collapsed by default)
    local Inner = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Visible = false,
        LayoutOrder = 2,
        Parent = Container,
    }, {
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 4),
        }),
        Create("UIPadding", {
            PaddingLeft = UDim.new(0, 14),
            PaddingRight = UDim.new(0, 4),
            PaddingTop = UDim.new(0, 4),
            PaddingBottom = UDim.new(0, 6),
        }),
    })

    ExpandBtn.MouseButton1Click:Connect(function()
        expanded = not expanded
        Inner.Visible = expanded
        ExpandBtn.Text = expanded and "-" or "+"
    end)

    dropdownObj.Instance = Container
    dropdownObj.Inner = Inner

    -- Allows nesting: dropdown:CreateToggle / :CreateButton / :CreateDropdown / :CreateToggleDropdown
    AttachElementFunctions(dropdownObj, Inner)

    return dropdownObj
end

--=========================================================================
-- ATTACH ELEMENT-CREATION METHODS TO ANY CONTAINER (Tab or Dropdown)
--=========================================================================
AttachElementFunctions = function(obj, parentFrame)
    function obj:CreateToggle(text, default, callback)
        return CreateToggleElement(parentFrame, text, default, callback)
    end

    function obj:CreateButton(text, callback)
        return CreateButtonElement(parentFrame, text, callback)
    end

    -- Normal Dropdown: expand/collapse only, no master switch
    function obj:CreateDropdown(text)
        return CreateDropdownElement(parentFrame, text, false, nil, nil)
    end

    -- Toggle Dropdown: has its own [Toggle] switch AND expand/collapse
    function obj:CreateToggleDropdown(text, default, callback)
        return CreateDropdownElement(parentFrame, text, true, default, callback)
    end
end

--=========================================================================
-- LIBRARY / WINDOW
--=========================================================================
local Library = {}
Library.__index = Library

function Library.new(title)
    local self = setmetatable({}, Library)

    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    local ScreenGui = Create("ScreenGui", {
        Name = "SimpleUILibrary",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = playerGui,
    })

    local Main = Create("Frame", {
        Name = "Main",
        Size = UDim2.new(0, 460, 0, 300),
        Position = UDim2.new(0.5, -230, 0.5, -150),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Parent = ScreenGui,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
        Create("UIStroke", { Color = Theme.Stroke, Thickness = 1 }),
    })

    local TitleBar = Create("Frame", {
        Name = "TitleBar",
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
        Parent = Main,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
    })

    -- Patch bottom corners of the title bar so it looks square against content below
    Create("Frame", {
        Size = UDim2.new(1, 0, 0, 6),
        Position = UDim2.new(0, 0, 1, -6),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
        Parent = TitleBar,
    })

    Create("TextLabel", {
        Text = title or "Window",
        Font = Theme.FontBold,
        TextSize = 14,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -40, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = TitleBar,
    })

    local CloseBtn = Create("TextButton", {
        Size = UDim2.new(0, 22, 0, 22),
        Position = UDim2.new(1, -28, 0.5, -11),
        BackgroundColor3 = Color3.fromRGB(45, 45, 50),
        AutoButtonColor = false,
        Text = "X",
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.SubText,
        Parent = TitleBar,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
    })
    CloseBtn.MouseButton1Click:Connect(function()
        ScreenGui.Enabled = false
    end)

    MakeDraggable(TitleBar, Main)

    -- Tab bar (left, thin)
    local TabBar = Create("Frame", {
        Name = "TabBar",
        Size = UDim2.new(0, 110, 1, -32),
        Position = UDim2.new(0, 0, 0, 32),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
        Parent = Main,
    }, {
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 2),
        }),
        Create("UIPadding", {
            PaddingTop = UDim.new(0, 6),
            PaddingLeft = UDim.new(0, 4),
            PaddingRight = UDim.new(0, 4),
        }),
    })

    -- Content area
    local ContentArea = Create("Frame", {
        Name = "ContentArea",
        Size = UDim2.new(1, -110, 1, -32),
        Position = UDim2.new(0, 110, 0, 32),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Parent = Main,
    })

    self.ScreenGui = ScreenGui
    self.Main = Main
    self.TabBar = TabBar
    self.ContentArea = ContentArea
    self.Tabs = {}
    self.ActiveTab = nil

    return self
end

function Library:SelectTab(tab)
    for _, t in ipairs(self.Tabs) do
        local isActive = (t == tab)
        t.Content.Visible = isActive
        t.Button.BackgroundColor3 = isActive and Theme.Accent or Theme.Secondary
        t.Button.TextColor3 = isActive and Color3.fromRGB(255, 255, 255) or Theme.SubText
    end
    self.ActiveTab = tab
end

function Library:CreateTab(name)
    local TabButton = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = Theme.Secondary,
        AutoButtonColor = false,
        Text = name,
        Font = Theme.Font,
        TextSize = 13,
        TextColor3 = Theme.SubText,
        Parent = self.TabBar,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
    })

    local TabContent = Create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = self.ContentArea,
    }, {
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 6),
        }),
        Create("UIPadding", {
            PaddingTop = UDim.new(0, 8),
            PaddingLeft = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 8),
            PaddingBottom = UDim.new(0, 8),
        }),
    })

    local Tab = {
        Button = TabButton,
        Content = TabContent,
    }

    TabButton.MouseButton1Click:Connect(function()
        self:SelectTab(Tab)
    end)

    table.insert(self.Tabs, Tab)
    AttachElementFunctions(Tab, TabContent)

    if not self.ActiveTab then
        self:SelectTab(Tab)
    end

    return Tab
end

function Library:Destroy()
    self.ScreenGui:Destroy()
end

return Library
