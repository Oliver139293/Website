    --=====================================================================
    -- ANIMATED THEME CHANGE
    --=====================================================================

    function self:ApplyTheme()

        local info =
            TweenInfo.new(
                0.35,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            )

        -- Main

        TweenService:Create(
            Main,
            info,
            {
                BackgroundColor3 =
                    Theme.Background,

                BackgroundTransparency =
                    UISettings.Transparency,
            }
        ):Play()

        -- Stroke

        if MainStroke then

            TweenService:Create(
                MainStroke,
                info,
                {
                    Color =
                        Theme.Stroke
                }
            ):Play()

        end

        -- Title

        TweenService:Create(
            TitleBar,
            info,
            {
                BackgroundColor3 =
                    Theme.Secondary,

                BackgroundTransparency =
                    UISettings.Transparency,
            }
        ):Play()

        TweenService:Create(
            TitleBottom,
            info,
            {
                BackgroundColor3 =
                    Theme.Secondary,

                BackgroundTransparency =
                    UISettings.Transparency,
            }
        ):Play()

        TweenService:Create(
            TitleLabel,
            info,
            {
                TextColor3 =
                    Theme.Text
            }
        ):Play()

        -- Minimize

        TweenService:Create(
            MinimizeBtn,
            info,
            {
                BackgroundColor3 =
                    Theme.Stroke,

                TextColor3 =
                    Theme.SubText,
            }
        ):Play()

        -- Close

        TweenService:Create(
            CloseBtn,
            info,
            {
                BackgroundColor3 =
                    Theme.Stroke,

                TextColor3 =
                    Theme.SubText,
            }
        ):Play()

        -- Tab bar

        TweenService:Create(
            TabBar,
            info,
            {
                BackgroundColor3 =
                    Theme.Secondary,

                BackgroundTransparency =
                    UISettings.Transparency,
            }
        ):Play()

        -- Content

        TweenService:Create(
            ContentArea,
            info,
            {
                BackgroundColor3 =
                    Theme.Background,

                BackgroundTransparency =
                    UISettings.Transparency,
            }
        ):Play()

        -- Registered objects

        for _, object in ipairs(self.ThemeObjects) do

            if object
                and object.Parent
                and object._Theme then

                object:_Theme(info)

            end

        end

    end

    --=====================================================================
    -- SET THEME
    --=====================================================================

    function self:SetTheme(themeName)

        local preset =
            ThemePresets[themeName]

        if not preset then
            return
        end

        UISettings.ThemeName =
            themeName

        for property, value in pairs(preset) do

            Theme[property] =
                value

        end

        self:ApplyTheme()

    end

    --=====================================================================
    -- TRANSPARENCY
    --=====================================================================

    function self:SetTransparency(value)

        UISettings.Transparency =
            math.clamp(value, 0, 0.9)

        self:ApplyTheme()

    end

    return self
end

--=========================================================================
-- SELECT TAB
--=========================================================================

function Library:SelectTab(tab)

    for _, t in ipairs(self.Tabs) do

        local active =
            t == tab

        t.Content.Visible =
            active

        t.Button.BackgroundColor3 =
            active
            and Theme.Accent
            or Theme.Secondary

        t.Button.TextColor3 =
            active
            and Color3.fromRGB(255, 255, 255)
            or Theme.SubText

    end

    self.ActiveTab =
        tab

end

