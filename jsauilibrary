        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = COLORS.Border,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        ZIndex = 2
    }, self.Content)

    new("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, page)

    new("UIPadding", {
        PaddingTop = UDim.new(0, 2),
        PaddingBottom = UDim.new(0, 8)
    }, page)

    tab.Button = button
    tab.Page = page

    function tab:SetActive(active)
        page.Visible = active

        if active then
            tween(button, 0.15, {
                BackgroundColor3 = COLORS.Accent,
                TextColor3 = COLORS.Text
            })
        else
            tween(button, 0.15, {
                BackgroundColor3 = COLORS.Surface2,
                TextColor3 = COLORS.SubText
            })
        end
    end

    function tab:CreateButton(text, callback)
        local b = new("TextButton", {
            Size = UDim2.new(1, -4, 0, 42),
            BackgroundColor3 = COLORS.Surface2,
            BorderSizePixel = 0,
            Text = text or "Button",
            TextColor3 = COLORS.Text,
            TextSize = 13,
            Font = Enum.Font.GothamMedium,
            AutoButtonColor = false,
            LayoutOrder = #tab.Items + 1
        }, page)
        corner(b, 7)
        stroke(b, COLORS.Border)

        b.MouseEnter:Connect(function()
            tween(b, 0.12, {BackgroundColor3 = COLORS.SurfaceHover})
        end)

        b.MouseLeave:Connect(function()
            tween(b, 0.12, {BackgroundColor3 = COLORS.Surface2})
        end)

        b.MouseButton1Click:Connect(function()
            if callback then
                callback()
            end
        end)

        table.insert(tab.Items, b)
        return b
    end

    function tab:CreateToggle(text, default, callback)
        local row = new("Frame", {
            Size = UDim2.new(1, -4, 0, 46),
            BackgroundColor3 = COLORS.Surface2,
            BorderSizePixel = 0,
            LayoutOrder = #tab.Items + 1
        }, page)
        corner(row, 7)
        stroke(row, COLORS.Border)

        new("TextLabel", {
            Size = UDim2.new(1, -75, 1, 0),
            Position = UDim2.fromOffset(14, 0),
            BackgroundTransparency = 1,
            Text = text or "Toggle",
            TextColor3 = COLORS.Text,
            TextSize = 13,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left
        }, row)

        local switch = new("TextButton", {
            Size = UDim2.fromOffset(42, 22),
            Position = UDim2.new(1, -56, 0.5, -11),
            BackgroundColor3 = COLORS.Off,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false
        }, row)
        corner(switch, 11)

        local knob = new("Frame", {
            Size = UDim2.fromOffset(16, 16),
            Position = UDim2.fromOffset(3, 3),
            BackgroundColor3 = Color3.fromRGB(235, 236, 240),
            BorderSizePixel = 0
        }, switch)
        corner(knob, 8)

        local state = default == true

        local function update()
            if state then
                tween(switch, 0.15, {BackgroundColor3 = COLORS.Accent})
                tween(knob, 0.15, {Position = UDim2.new(1, -19, 0, 3)})
            else
                tween(switch, 0.15, {BackgroundColor3 = COLORS.Off})
                tween(knob, 0.15, {Position = UDim2.fromOffset(3, 3)})
            end
        end

        update()

        switch.MouseButton1Click:Connect(function()
            state = not state
            update()

            if callback then
                callback(state)
            end
        end)

        local api = {}
        function api:Get()
            return state
        end

        function api:Set(value)
            state = value == true
            update()

            if callback then
                callback(state)
            end
        end

        table.insert(tab.Items, row)
        return api
    end

