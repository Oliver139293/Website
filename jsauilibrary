        TextColor3 = COLORS.SubText,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = false,
        ZIndex = 3
    }, self.TabBar)
    corner(button, 7)

    local page = new("ScrollingFrame", {
        Name = name .. "Page",
        Size = UDim2.new(1, -16, 1, -16),
        Position = UDim2.fromOffset(8, 8),
